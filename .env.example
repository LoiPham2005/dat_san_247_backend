
# ==============================================================================
# 🚀 DAT SAN 247 BACKEND ENV EXAMPLE
# ==============================================================================
# Copy this file to .env and fill in the values

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIG
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development  # development, production, test
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,*

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=dat_san_247
DB_LOGGING=false
DB_SSL=false
DB_SYNCHRONIZE=false
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. SOCIAL LOGIN (OAuth2)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/auth/facebook/callback

# ------------------------------------------------------------------------------
# 5. STORAGE SERVICE
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local # local, supabase, r2, s3
STORAGE_LOCAL_PATH=./uploads

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=dat_san_247

# Cloudflare R2 / AWS S3
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 6. CACHE & QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=600

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Dat San 247 <no-reply@datsan247.com>"

# ------------------------------------------------------------------------------
# 8. SMS SERVICE
# ------------------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=DatSan247

# ------------------------------------------------------------------------------
# 9. PUSH NOTIFICATIONS (Firebase)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 10. PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ------------------------------------------------------------------------------
# 11. MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=pretty