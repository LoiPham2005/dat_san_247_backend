// ================================================================
// PRISMA SCHEMA - Sports Court Booking Platform v3
// Production-Ready | PostgreSQL | Optimized
// 6 Roles: super_admin, admin, staff, owner, venue_staff, customer
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// ENUMS
// ================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
}

enum OtpType {
  EMAIL_VERIFY
  PHONE_VERIFY
  RESET_PASSWORD
  TWO_FACTOR
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum VenueStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourtSurfaceType {
  GRASS
  ARTIFICIAL_GRASS
  CONCRETE
  WOOD
  RUBBER
  CLAY
  SAND
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  CONVERTED
  EXPIRED
  CANCELLED
}

enum RecurringType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TimeSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

// ----------------------------------------------------------------
// VenueStaffRole — dùng trong venue_staff table
// OWNER    = chủ sân (tự động assign khi tạo venue)
// MANAGER  = quản lý được uỷ quyền bởi owner
// STAFF    = nhân viên vận hành
// RECEPTIONIST = lễ tân check-in
// ----------------------------------------------------------------
enum VenueStaffRole {
  OWNER
  MANAGER
  STAFF
  RECEPTIONIST
}

enum VenueServiceType {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  VNPAY
  MOMO
  ZALOPAY
  BANK_TRANSFER
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  PAYOUT
  COMMISSION
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum VoucherStatus {
  UNUSED
  USED
  EXPIRED
}

enum FileCategory {
  AVATAR
  VENUE_IMAGE
  COURT_IMAGE
  REVIEW_IMAGE
  DOCUMENT
  BANNER_IMAGE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REVIEW_RECEIVED
  PROMOTION
  PAYOUT_PROCESSED
  VENUE_STAFF_INVITE
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BOOKING_ISSUE
  PAYMENT_ISSUE
  VENUE_ISSUE
  ACCOUNT_ISSUE
  REFUND_REQUEST
  OTHER
}

enum ReportTargetType {
  USER
  VENUE
  REVIEW
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FAKE
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAction {
  NONE
  FLAG
  BLOCK
  MANUAL_REVIEW
}

// ----------------------------------------------------------------
// VenueStaffInviteStatus — trạng thái lời mời làm việc tại sân
// ----------------------------------------------------------------
enum VenueStaffInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

// ================================================================
// SECTION 1 — AUTH & USERS
// ================================================================

// ----------------------------------------------------------------
// users — bảng chính cho TẤT CẢ roles
//
// CÁCH PHÂN QUYỀN:
//   Platform roles  → users.role_id → roles.slug:
//     'super_admin' | 'admin' | 'staff' | 'owner' | 'customer'
//
//   Venue-level     → venue_staff.role (VenueStaffRole):
//     OWNER | MANAGER | STAFF | RECEPTIONIST
//     (1 user có thể là staff ở nhiều venue khác nhau)
//
// NOTE: user với role 'owner' trên platform PHẢI có ít nhất 1 record
//   trong venue_staff với role=OWNER khi họ tạo venue
// ----------------------------------------------------------------
model users {
  id                    String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at            DateTime   @default(now()) @db.Timestamp(6)
  updated_at            DateTime   @updatedAt @db.Timestamp(6)
  deleted_at            DateTime?  @db.Timestamp(6)

  email                 String     @unique @db.VarChar(255)
  username              String?    @unique @db.VarChar(100)
  password_hash         String     @db.VarChar(255)
  full_name             String     @db.VarChar(255)
  phone                 String?    @unique @db.VarChar(20)
  avatar_url            String?    @db.VarChar(500)
  gender                Gender?
  date_of_birth         DateTime?  @db.Date

  status                UserStatus @default(ACTIVE)
  kyc_status            KycStatus  @default(UNVERIFIED)
  is_email_verified     Boolean    @default(false)
  is_phone_verified     Boolean    @default(false)
  email_verified_at     DateTime?  @db.Timestamp(6)
  phone_verified_at     DateTime?  @db.Timestamp(6)
  last_login_at         DateTime?  @db.Timestamp(6)

  // Platform role — xác định quyền trên toàn hệ thống
  role_id               String?    @db.Uuid

  // Relations - Auth
  role                  roles?                   @relation(fields: [role_id], references: [id])
  refresh_tokens        refresh_tokens[]
  otp_verifications     otp_verifications[]

  // Relations - Profile
  profile               user_profiles?
  notification_settings notification_settings?
  devices               user_devices[]

  // Relations - Venue (dùng cho OWNER + VENUE_STAFF)
  owned_venues          venues[]                 // venues mà user này là owner
  venue_staff           venue_staff[]            // tất cả venue user này làm việc
  venue_staff_invites_sent     venue_staff_invites[] @relation("invite_sender")
  venue_staff_invites_received venue_staff_invites[] @relation("invite_receiver")

  // Relations - Booking
  bookings              bookings[]
  booking_status_history booking_status_history[]
  booking_waitlist      booking_waitlist[]
  recurring_bookings    recurring_bookings[]

  // Relations - Finance
  wallet                wallets?
  transactions          transactions[]
  payout_requests_own   payout_requests[]        @relation("payout_owner")
  payout_requests_proc  payout_requests[]        @relation("payout_processor")
  invoices              invoices[]

  // Relations - Content
  reviews               reviews[]
  files                 files[]
  favorite_venues       favorite_venues[]
  user_vouchers         user_vouchers[]
  notifications         notifications[]
  promotion_usage       promotion_usage[]

  // Relations - Admin/Support (dùng cho ADMIN + STAFF)
  support_tickets_as_customer support_tickets[]  @relation("ticket_customer")
  support_tickets_as_agent    support_tickets[]  @relation("ticket_agent")
  support_ticket_messages     support_ticket_messages[]
  reports_submitted     reports[]                @relation("report_reporter")
  reports_reviewed      reports[]                @relation("report_reviewer")
  fraud_as_subject      fraud_detections[]       @relation("fraud_subject")
  fraud_as_reviewer     fraud_detections[]       @relation("fraud_reviewer")
  audit_logs            audit_logs[]

  @@index([email])
  @@index([phone])
  @@index([role_id])
  @@index([status])
  @@index([deleted_at])
}

model user_profiles {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @updatedAt @db.Timestamp(6)

  user_id            String    @unique @db.Uuid
  bio                String?   @db.Text
  cover_url          String?   @db.VarChar(500)
  address            String?   @db.VarChar(500)
  city               String?   @db.VarChar(100)
  district           String?   @db.VarChar(100)
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)

  referral_code      String?   @unique @db.VarChar(20)
  referred_by_id     String?   @db.Uuid

  total_bookings     Int       @default(0)
  reliability_score  Int       @default(100)

  is_profile_public  Boolean   @default(true)
  show_email         Boolean   @default(false)
  show_phone         Boolean   @default(false)
  preferred_language String    @default("vi") @db.VarChar(10)
  timezone           String    @default("Asia/Ho_Chi_Minh") @db.VarChar(50)

  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  referred_by        users?    @relation("user_referrals", fields: [referred_by_id], references: [id])
  sport_preferences  user_sport_preferences[]

  @@index([user_id])
  @@index([referral_code])
}

model user_sport_preferences {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_profile_id String        @db.Uuid
  sport_type      String        @db.VarChar(50)
  skill_level     Int           @default(1)

  user_profiles   user_profiles @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, sport_type])
  @@index([sport_type])
}

model user_devices {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  user_id        String    @db.Uuid
  fcm_token      String    @unique @db.VarChar(500)
  device_type    String?   @db.VarChar(20)
  device_model   String?   @db.VarChar(100)
  os_version     String?   @db.VarChar(20)
  app_version    String?   @db.VarChar(20)
  is_active      Boolean   @default(true)
  last_active_at DateTime  @default(now()) @db.Timestamp(6)

  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)

  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  is_revoked Boolean   @default(false)
  ip_address String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(500)

  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model otp_verifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)

  user_id    String    @db.Uuid
  type       OtpType
  code_hash  String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  is_used    Boolean   @default(false)
  used_at    DateTime? @db.Timestamp(6)
  attempts   Int       @default(0)

  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
  @@index([expires_at])
}

model notification_settings {
  user_id              String   @id @db.Uuid
  updated_at           DateTime @updatedAt @db.Timestamp(6)

  enable_push          Boolean  @default(true)
  enable_email         Boolean  @default(true)
  enable_sms           Boolean  @default(false)
  booking_reminders    Boolean  @default(true)
  promotional_messages Boolean  @default(true)
  payment_alerts       Boolean  @default(true)
  system_alerts        Boolean  @default(true)
  staff_alerts         Boolean  @default(true) // cho venue_staff: booking mới, check-in, etc.

  users                users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ================================================================
// SECTION 2 — ROLES & PERMISSIONS (Platform-level)
// ================================================================

// ----------------------------------------------------------------
// roles — 6 platform roles cố định:
//   super_admin : Toàn quyền hệ thống, quản lý admin khác, settings
//   admin       : Approve venue, quản lý user, xử lý report/support
//   staff       : Xử lý support tickets, review report
//   owner       : Chủ sân — quản lý venue/courts/revenue của mình
//   customer    : Đặt sân, thanh toán, review
//
// NOTE: "venue_staff" KHÔNG phải platform role — họ vẫn có role
//   'customer' trên platform NHƯNG có thêm record trong venue_staff
//   Điều này cho phép: 1 người vừa là customer vừa là staff của sân
// ----------------------------------------------------------------
model roles {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamp(6)

  name             String             @unique @db.VarChar(100)
  slug             String             @unique @db.VarChar(100)
  description      String?
  is_system        Boolean            @default(false) // system roles không được xoá
  is_active        Boolean            @default(true)

  users            users[]
  role_permissions role_permissions[]
}

model permissions {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug             String             @unique @db.VarChar(100)
  resource         String             @db.VarChar(100)
  action           String             @db.VarChar(50)
  description      String?
  scope            String             @default("platform") @db.VarChar(20) // 'platform' | 'venue'

  role_permissions role_permissions[]

  @@index([resource])
  @@index([scope])
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid

  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

// ================================================================
// SECTION 3 — FILES
// ================================================================

model files {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime     @default(now()) @db.Timestamp(6)

  user_id       String?      @db.Uuid
  category      FileCategory
  original_name String       @db.VarChar(255)
  file_name     String       @db.VarChar(255)
  file_size     BigInt
  mime_type     String       @db.VarChar(100)
  storage_key   String?      @db.VarChar(500)
  bucket        String?      @db.VarChar(100)
  public_url    String       @db.VarChar(1000)
  width         Int?
  height        Int?

  users         users?       @relation(fields: [user_id], references: [id])
  venue_images  venue_images[]
  court_images  court_images[]
  review_images review_images[]

  @@index([user_id])
  @@index([category])
}

// ================================================================
// SECTION 4 — VENUES
// ================================================================

model venues {
  id                        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                DateTime    @default(now()) @db.Timestamp(6)
  updated_at                DateTime    @updatedAt @db.Timestamp(6)
  deleted_at                DateTime?   @db.Timestamp(6)

  owner_id                  String      @db.Uuid
  name                      String      @db.VarChar(255)
  slug                      String      @unique @db.VarChar(255)
  description               String?     @db.Text
  address                   String      @db.VarChar(500)
  city                      String      @db.VarChar(100)
  district                  String      @db.VarChar(100)
  ward                      String?     @db.VarChar(100)
  latitude                  Decimal?    @db.Decimal(10, 8)
  longitude                 Decimal?    @db.Decimal(11, 8)
  phone                     String?     @db.VarChar(20)
  email                     String?     @db.VarChar(255)

  status                    VenueStatus @default(PENDING)
  rejection_reason          String?
  is_active                 Boolean     @default(true)
  is_featured               Boolean     @default(false)
  featured_until            DateTime?   @db.Timestamp(6)
  thumbnail_url             String?     @db.VarChar(500)

  opening_time              DateTime    @default(dbgenerated("'06:00:00'::time without time zone")) @db.Time(6)
  closing_time              DateTime    @default(dbgenerated("'23:00:00'::time without time zone")) @db.Time(6)

  // Ratings (denormalized cho performance)
  rating                    Decimal     @default(0) @db.Decimal(3, 2)
  rating_cleanliness        Decimal     @default(0) @db.Decimal(3, 2)
  rating_facilities         Decimal     @default(0) @db.Decimal(3, 2)
  rating_staff              Decimal     @default(0) @db.Decimal(3, 2)
  total_reviews             Int         @default(0)

  // Business config
  commission_rate           Decimal     @default(0) @db.Decimal(5, 2)
  vat_rate                  Decimal     @default(0) @db.Decimal(5, 2)
  auto_accept_bookings      Boolean     @default(true)
  min_booking_hours         Int         @default(1)
  max_booking_hours         Int         @default(24)
  min_booking_before_hours  Int         @default(0)
  cancellation_before_hours Int         @default(24)

  // Admin notes (dùng cho admin/staff platform)
  admin_notes               String?     @db.Text
  approved_at               DateTime?   @db.Timestamp(6)
  approved_by               String?     @db.Uuid

  users                     users       @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  courts                    courts[]
  venue_images              venue_images[]
  venue_sport_types         venue_sport_types[]
  venue_amenities           venue_amenities[]
  venue_social_links        venue_social_links[]
  venue_operating_hours     venue_operating_hours[]
  venue_schedule_exceptions venue_schedule_exceptions[]
  venue_staff               venue_staff[]
  venue_staff_invites       venue_staff_invites[]
  venue_services            venue_services[]
  venue_verifications       venue_verifications[]
  refund_policies           refund_policies[]
  bookings                  bookings[]
  recurring_bookings        recurring_bookings[]
  reviews                   reviews[]
  favorite_venues           favorite_venues[]
  promotion_venues          promotion_venues[]
  revenue_snapshots         venue_revenue_snapshots[]
  support_tickets           support_tickets[]

  @@index([owner_id])
  @@index([status])
  @@index([city])
  @@index([district])
  @@index([is_featured])
  @@index([deleted_at])
}

model venue_sport_types {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_id   String  @db.Uuid
  sport_type String  @db.VarChar(50)

  venues     venues  @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, sport_type])
  @@index([sport_type])
}

model venue_amenities {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_id String  @db.Uuid
  name     String  @db.VarChar(100)
  icon     String? @db.VarChar(100)
  is_free  Boolean @default(true)

  venues   venues  @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, name])
  @@index([venue_id])
}

model venue_social_links {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_id String @db.Uuid
  platform String @db.VarChar(50)
  url      String @db.VarChar(500)

  venues   venues @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, platform])
}

model venue_images {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)
  venue_id      String   @db.Uuid
  file_id       String   @db.Uuid
  display_order Int      @default(0)
  is_cover      Boolean  @default(false)
  caption       String?  @db.VarChar(255)

  venues        venues   @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  files         files    @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@index([venue_id])
}

model venue_operating_hours {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_id     String    @db.Uuid
  day_of_week  DayOfWeek
  opening_time DateTime  @db.Time(6)
  closing_time DateTime  @db.Time(6)
  is_closed    Boolean   @default(false)

  venues       venues    @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, day_of_week])
}

model venue_schedule_exceptions {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  venue_id   String    @db.Uuid
  date       DateTime  @db.Date
  is_closed  Boolean   @default(true)
  open_time  DateTime? @db.Time(6)
  close_time DateTime? @db.Time(6)
  reason     String?   @db.VarChar(255)

  venues     venues    @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, date])
  @@index([date])
}

model venue_verifications {
  id                      String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at              DateTime           @default(now()) @db.Timestamp(6)
  updated_at              DateTime           @updatedAt @db.Timestamp(6)

  venue_id                String             @db.Uuid
  business_license_url    String             @db.VarChar(500)
  id_card_front_url       String             @db.VarChar(500)
  id_card_back_url        String             @db.VarChar(500)
  owner_photo_url         String             @db.VarChar(500)
  status                  VerificationStatus @default(PENDING)
  verified_at             DateTime?          @db.Timestamp(6)
  verified_by             String?            @db.Uuid
  rejection_reason        String?

  venues                  venues             @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@index([venue_id])
  @@index([status])
}

// ----------------------------------------------------------------
// venue_staff — quản lý nhân viên tại từng venue
//
// ROLES:
//   OWNER       : Tự động tạo khi user tạo venue. Toàn quyền venue
//   MANAGER     : Được owner uỷ quyền. Quản lý booking, staff, dịch vụ
//   STAFF       : Vận hành hàng ngày. Check-in, xem booking
//   RECEPTIONIST: Chỉ check-in và xem lịch hôm nay
//
// QUAN TRỌNG:
//   - Khi tạo venue → tự động tạo venue_staff record cho owner
//   - is_active = false khi staff bị tạm ngưng (vẫn giữ lịch sử)
//   - permissions[] override — owner có thể cấp thêm quyền đặc biệt
// ----------------------------------------------------------------
model venue_staff {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)

  venue_id     String         @db.Uuid
  user_id      String         @db.Uuid
  role         VenueStaffRole @default(STAFF)
  is_active    Boolean        @default(true)

  // Audit trail
  invited_by   String?        @db.Uuid  // ai thêm staff này
  joined_at    DateTime?      @db.Timestamp(6)
  deactivated_at DateTime?    @db.Timestamp(6)
  deactivated_by String?      @db.Uuid

  // Staff working schedule (optional)
  work_start_time DateTime?   @db.Time(6)
  work_end_time   DateTime?   @db.Time(6)
  work_days       String?     @db.VarChar(50) // e.g. "MON,TUE,WED" — denormalized for simplicity

  // Internal note từ owner/manager
  note          String?       @db.VarChar(500)

  venues        venues        @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permissions   venue_staff_permissions[]

  @@unique([venue_id, user_id])
  @@index([venue_id])
  @@index([user_id])
  @@index([role])
  @@index([is_active])
}

// ----------------------------------------------------------------
// venue_staff_permissions — quyền bổ sung cho từng staff
//
// Dùng khi owner muốn cấp quyền ngoài role mặc định
// Ví dụ: RECEPTIONIST được phép xem doanh thu của ngày hôm nay
// ----------------------------------------------------------------
model venue_staff_permissions {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_staff_id String      @db.Uuid
  permission     String      @db.VarChar(100) // e.g. "bookings:cancel", "revenue:view_daily"
  granted_by     String      @db.Uuid
  granted_at     DateTime    @default(now()) @db.Timestamp(6)

  venue_staff    venue_staff @relation(fields: [venue_staff_id], references: [id], onDelete: Cascade)

  @@unique([venue_staff_id, permission])
  @@index([venue_staff_id])
}

// ----------------------------------------------------------------
// venue_staff_invites — lời mời nhân viên vào làm tại venue
//
// Flow: Owner/Manager gửi invite → Staff nhận email/link
//   → Staff accept/reject → Nếu accept: tạo venue_staff record
// ----------------------------------------------------------------
model venue_staff_invites {
  id           String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime                @default(now()) @db.Timestamp(6)
  updated_at   DateTime                @updatedAt @db.Timestamp(6)

  venue_id     String                  @db.Uuid
  sender_id    String                  @db.Uuid   // owner/manager gửi invite
  receiver_id  String?                 @db.Uuid   // nếu đã có tài khoản
  invite_email String                  @db.VarChar(255) // email được mời
  role         VenueStaffRole          @default(STAFF)
  token        String                  @unique @db.VarChar(100) // token trong link invite
  expires_at   DateTime                @db.Timestamp(6)
  status       VenueStaffInviteStatus  @default(PENDING)
  message      String?                 @db.VarChar(500) // lời nhắn từ sender

  responded_at DateTime?               @db.Timestamp(6)

  venues       venues                  @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  sender       users                   @relation("invite_sender", fields: [sender_id], references: [id])
  receiver     users?                  @relation("invite_receiver", fields: [receiver_id], references: [id])

  @@index([venue_id])
  @@index([invite_email])
  @@index([token])
  @@index([status])
}

model venue_services {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @updatedAt @db.Timestamp(6)

  venue_id        String           @db.Uuid
  name            String           @db.VarChar(255)
  description     String?
  price           Decimal          @db.Decimal(15, 2)
  unit            String           @default("unit") @db.VarChar(50)
  type            VenueServiceType @default(SERVICE)
  category        String?          @db.VarChar(100)
  is_available    Boolean          @default(true)
  track_inventory Boolean          @default(false)
  stock_quantity  Int              @default(0)

  venues          venues           @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  booking_addons  booking_addons[]

  @@index([venue_id])
}

model venue_revenue_snapshots {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_id           String   @db.Uuid
  snapshot_date      DateTime @db.Date
  total_revenue      Decimal  @default(0) @db.Decimal(15, 2)
  total_bookings     Int      @default(0)
  cancelled_bookings Int      @default(0)
  service_revenue    Decimal  @default(0) @db.Decimal(15, 2)
  net_profit         Decimal  @default(0) @db.Decimal(15, 2)
  commission_paid    Decimal  @default(0) @db.Decimal(15, 2)

  venues             venues   @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, snapshot_date])
  @@index([snapshot_date])
}

// ================================================================
// SECTION 5 — COURTS
// ================================================================

model courts {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @updatedAt @db.Timestamp(6)
  deleted_at        DateTime?         @db.Timestamp(6)

  venue_id          String            @db.Uuid
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  price_per_hour    Decimal           @db.Decimal(10, 2)
  surface_type      CourtSurfaceType?
  size              String?           @db.VarChar(50)
  is_indoor         Boolean           @default(false)
  width             Decimal?          @db.Decimal(5, 2)
  length            Decimal?          @db.Decimal(5, 2)
  height            Decimal?          @db.Decimal(5, 2)
  is_active         Boolean           @default(true)
  thumbnail_url     String?           @db.VarChar(500)
  parent_court_id   String?           @db.Uuid

  venues            venues            @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  parent_court      courts?           @relation("court_children", fields: [parent_court_id], references: [id])
  sub_courts        courts[]          @relation("court_children")

  court_images      court_images[]
  court_sport_types court_sport_types[]
  court_amenities   court_amenities[]
  pricing_rules     pricing_rules[]
  time_slots        time_slots[]
  court_maintenance court_maintenance[]

  bookings          bookings[]
  recurring_bookings recurring_bookings[]
  booking_waitlist  booking_waitlist[]
  reviews           reviews[]
  promotion_courts  promotion_courts[]

  @@index([venue_id])
  @@index([is_active])
  @@index([deleted_at])
}

model court_sport_types {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  court_id   String   @db.Uuid
  sport_type String   @db.VarChar(50)

  courts     courts   @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@unique([court_id, sport_type])
  @@index([sport_type])
}

model court_amenities {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  court_id String  @db.Uuid
  name     String  @db.VarChar(100)
  is_free  Boolean @default(true)

  courts   courts  @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@unique([court_id, name])
}

model court_images {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)
  court_id      String   @db.Uuid
  file_id       String   @db.Uuid
  display_order Int      @default(0)
  is_cover      Boolean  @default(false)
  caption       String?  @db.VarChar(255)

  courts        courts   @relation(fields: [court_id], references: [id], onDelete: Cascade)
  files         files    @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@index([court_id])
}

model court_maintenance {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  court_id     String    @db.Uuid
  start_at     DateTime  @db.Timestamp(6)
  end_at       DateTime  @db.Timestamp(6)
  reason       String    @db.VarChar(500)
  is_emergency Boolean   @default(false)
  created_by   String?   @db.Uuid  // staff/manager tạo lịch maintenance

  courts       courts    @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@index([court_id])
  @@index([start_at])
}

model pricing_rules {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)

  court_id    String     @db.Uuid
  name        String?    @db.VarChar(100)
  day_of_week DayOfWeek?
  start_time  DateTime   @db.Time(6)
  end_time    DateTime   @db.Time(6)
  price       Decimal    @db.Decimal(10, 2)
  start_date  DateTime?  @db.Date
  end_date    DateTime?  @db.Date
  priority    Int        @default(1)
  is_active   Boolean    @default(true)

  courts      courts     @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@index([court_id])
  @@index([is_active])
}

model time_slots {
  id         String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  court_id   String         @db.Uuid
  date       DateTime       @db.Date
  start_time DateTime       @db.Time(6)
  end_time   DateTime       @db.Time(6)
  status     TimeSlotStatus @default(AVAILABLE)
  price      Decimal        @db.Decimal(10, 2)

  courts     courts         @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@unique([court_id, date, start_time, end_time])
  @@index([court_id, date])
  @@index([status])
}

// ================================================================
// SECTION 6 — BOOKINGS
// ================================================================

model bookings {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at            DateTime      @default(now()) @db.Timestamp(6)
  updated_at            DateTime      @updatedAt @db.Timestamp(6)
  deleted_at            DateTime?     @db.Timestamp(6)

  booking_code          String        @unique @db.VarChar(20)
  check_in_code         String?       @unique @db.VarChar(10)
  customer_id           String        @db.Uuid
  court_id              String        @db.Uuid
  venue_id              String        @db.Uuid
  recurring_booking_id  String?       @db.Uuid
  rescheduled_from_id   String?       @db.Uuid

  booking_date          DateTime      @db.Date
  start_time            DateTime      @db.Time(6)
  end_time              DateTime      @db.Time(6)
  status                BookingStatus @default(PENDING)

  total_hours           Decimal       @db.Decimal(4, 2)
  price_per_hour        Decimal       @db.Decimal(10, 2)
  sub_total             Decimal       @default(0) @db.Decimal(10, 2)
  discount_amount       Decimal       @default(0) @db.Decimal(10, 2)
  vat_rate              Decimal       @default(0) @db.Decimal(5, 2)
  vat_amount            Decimal       @default(0) @db.Decimal(10, 2)
  commission_amount     Decimal       @default(0) @db.Decimal(10, 2)
  platform_fee          Decimal       @default(0) @db.Decimal(10, 2)
  total_amount          Decimal       @db.Decimal(10, 2)
  deposit_amount        Decimal       @default(0) @db.Decimal(10, 2)
  refund_amount         Decimal       @default(0) @db.Decimal(10, 2)
  cancellation_fee      Decimal       @default(0) @db.Decimal(10, 2)

  promotion_code        String?       @db.VarChar(50)
  note                  String?       @db.Text
  cancellation_deadline DateTime?     @db.Timestamp(6)
  checked_in_at         DateTime?     @db.Timestamp(6)
  checked_in_by         String?       @db.Uuid    // venue_staff.user_id thực hiện check-in
  cancelled_at          DateTime?     @db.Timestamp(6)
  cancelled_by          String?       @db.Uuid    // ai cancel
  cancellation_reason   String?

  customers             users                  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  courts                courts                 @relation(fields: [court_id], references: [id], onDelete: Cascade)
  venues                venues                 @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  recurring_booking     recurring_bookings?    @relation(fields: [recurring_booking_id], references: [id])
  rescheduled_from      bookings?              @relation("booking_reschedules", fields: [rescheduled_from_id], references: [id])
  rescheduled_to        bookings[]             @relation("booking_reschedules")

  booking_addons        booking_addons[]
  booking_status_history booking_status_history[]
  payments              payments[]
  invoice               invoices?
  reviews               reviews[]
  transactions          transactions[]
  promotion_usage       promotion_usage[]
  support_tickets       support_tickets[]
  fraud_detections      fraud_detections[]

  @@index([customer_id])
  @@index([court_id])
  @@index([venue_id])
  @@index([booking_date])
  @@index([status])
  @@index([booking_code])
}

model booking_addons {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamp(6)
  booking_id     String         @db.Uuid
  service_id     String         @db.Uuid
  quantity       Int            @default(1)
  price_per_unit Decimal        @db.Decimal(15, 2)
  total_price    Decimal        @db.Decimal(15, 2)
  note           String?
  added_by       String?        @db.Uuid // staff có thể add dịch vụ khi check-in

  bookings       bookings       @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  venue_services venue_services @relation(fields: [service_id], references: [id])

  @@index([booking_id])
}

model booking_status_history {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  booking_id   String        @db.Uuid
  status       BookingStatus
  changed_by   String?       @db.Uuid
  actor_role   String?       @db.VarChar(50) // 'customer' | 'venue_staff' | 'admin' | 'system'
  note         String?

  bookings     bookings      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  users        users?        @relation(fields: [changed_by], references: [id])

  @@index([booking_id])
}

model booking_waitlist {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  user_id      String         @db.Uuid
  court_id     String         @db.Uuid
  booking_date DateTime       @db.Date
  start_time   DateTime       @db.Time(6)
  end_time     DateTime       @db.Time(6)
  priority     Int            @default(1)
  is_notified  Boolean        @default(false)
  status       WaitlistStatus @default(WAITING)

  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  courts       courts         @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([court_id, booking_date])
}

model recurring_bookings {
  id                  String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamp(6)
  updated_at          DateTime      @updatedAt @db.Timestamp(6)

  user_id             String        @db.Uuid
  venue_id            String        @db.Uuid
  court_id            String        @db.Uuid
  repeat_type         RecurringType @default(WEEKLY)
  start_time          DateTime      @db.Time(6)
  end_time            DateTime      @db.Time(6)
  start_date          DateTime      @db.Date
  end_date            DateTime?     @db.Date
  is_active           Boolean       @default(true)
  last_generated_date DateTime?     @db.Date

  users               users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  venues              venues                  @relation(fields: [venue_id], references: [id])
  courts              courts                  @relation(fields: [court_id], references: [id])
  bookings            bookings[]
  recurring_days      recurring_booking_days[]

  @@index([user_id])
  @@index([court_id])
}

model recurring_booking_days {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recurring_booking_id String             @db.Uuid
  day_of_week          DayOfWeek

  recurring_bookings   recurring_bookings @relation(fields: [recurring_booking_id], references: [id], onDelete: Cascade)

  @@unique([recurring_booking_id, day_of_week])
}

// ================================================================
// SECTION 7 — REFUND POLICIES
// ================================================================

model refund_policies {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  updated_at   DateTime      @updatedAt @db.Timestamp(6)

  venue_id     String?       @db.Uuid
  name         String        @db.VarChar(255)
  description  String?
  is_active    Boolean       @default(true)
  is_default   Boolean       @default(false)

  venues       venues?       @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  refund_rules refund_rules[]

  @@index([venue_id])
}

model refund_rules {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  policy_id           String          @db.Uuid
  cancel_before_hours Int
  refund_percentage   Decimal         @db.Decimal(5, 2)
  description         String?

  refund_policies     refund_policies @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@index([policy_id])
}

// ================================================================
// SECTION 8 — PAYMENTS & FINANCES
// ================================================================

model payments {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime      @default(now()) @db.Timestamp(6)
  updated_at       DateTime      @updatedAt @db.Timestamp(6)

  booking_id       String        @db.Uuid
  gateway_txn_id   String?       @unique @db.VarChar(100)
  amount           Decimal       @db.Decimal(10, 2)
  payment_method   PaymentMethod
  status           PaymentStatus @default(PENDING)
  paid_at          DateTime?     @db.Timestamp(6)
  gateway_response String?       @db.Text

  bookings         bookings      @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@index([status])
}

model wallets {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  user_id        String    @unique @db.Uuid
  balance        Decimal   @default(0) @db.Decimal(15, 2)
  locked_balance Decimal   @default(0) @db.Decimal(15, 2)
  currency       String    @default("VND") @db.VarChar(10)
  is_active      Boolean   @default(true)
  version        Int       @default(0) // optimistic lock

  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bank_accounts  payout_bank_accounts[]
}

model payout_bank_accounts {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamp(6)
  wallet_id      String   @db.Uuid
  bank_name      String   @db.VarChar(100)
  bank_code      String   @db.VarChar(20)
  account_number String   @db.VarChar(50)
  account_name   String   @db.VarChar(255)
  branch         String?  @db.VarChar(255)
  is_default     Boolean  @default(false)

  wallets        wallets  @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id])
}

model transactions {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @updatedAt @db.Timestamp(6)

  user_id          String            @db.Uuid
  type             TransactionType
  amount           Decimal           @db.Decimal(15, 2)
  balance_after    Decimal           @db.Decimal(15, 2)
  status           TransactionStatus @default(PENDING)
  reference_id     String?           @db.Uuid
  description      String?
  payment_provider String?           @db.VarChar(50)

  users            users             @relation(fields: [user_id], references: [id])
  bookings         bookings?         @relation(fields: [reference_id], references: [id])
  invoice          invoices?
  disputes         transaction_disputes[]

  @@index([user_id])
  @@index([type])
  @@index([status])
  @@index([reference_id])
}

model transaction_disputes {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @updatedAt @db.Timestamp(6)

  transaction_id  String        @db.Uuid
  reporter_id     String        @db.Uuid
  reason          String        @db.Text
  status          DisputeStatus @default(OPEN)
  resolution_note String?
  resolved_at     DateTime?     @db.Timestamp(6)
  resolved_by     String?       @db.Uuid // admin/staff platform giải quyết

  transactions    transactions  @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id])
  @@index([reporter_id])
  @@index([status])
}

model invoices {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamp(6)

  invoice_number String        @unique @db.VarChar(50)
  booking_id     String?       @unique @db.Uuid
  transaction_id String        @unique @db.Uuid
  customer_id    String        @db.Uuid
  amount         Decimal       @db.Decimal(15, 2)
  tax_amount     Decimal       @default(0) @db.Decimal(15, 2)
  status         InvoiceStatus @default(ISSUED)
  issued_at      DateTime      @default(now()) @db.Timestamp(6)
  pdf_url        String?       @db.VarChar(500)

  bookings       bookings?     @relation(fields: [booking_id], references: [id])
  transactions   transactions  @relation(fields: [transaction_id], references: [id])
  customers      users         @relation(fields: [customer_id], references: [id])
  invoice_items  invoice_items[]

  @@index([customer_id])
  @@index([status])
}

model invoice_items {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_id   String    @db.Uuid
  item_type    String    @db.VarChar(50)
  reference_id String?   @db.Uuid
  name         String    @db.VarChar(255)
  quantity     Int       @default(1)
  unit_price   Decimal   @db.Decimal(15, 2)
  subtotal     Decimal   @db.Decimal(15, 2)
  tax_amount   Decimal   @default(0) @db.Decimal(15, 2)
  total_amount Decimal   @db.Decimal(15, 2)

  invoices     invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
}

model payout_requests {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime     @default(now()) @db.Timestamp(6)
  updated_at       DateTime     @updatedAt @db.Timestamp(6)

  user_id          String       @db.Uuid
  amount           Decimal      @db.Decimal(15, 2)
  currency         String       @default("VND") @db.VarChar(10)
  status           PayoutStatus @default(PENDING)
  bank_account_id  String       @db.Uuid
  admin_note       String?
  rejection_reason String?
  proof_image_url  String?      @db.VarChar(500)
  processed_at     DateTime?    @db.Timestamp(6)
  processed_by     String?      @db.Uuid // admin/staff platform xử lý

  users            users        @relation("payout_owner", fields: [user_id], references: [id], onDelete: Cascade)
  processor        users?       @relation("payout_processor", fields: [processed_by], references: [id])

  @@index([user_id])
  @@index([status])
}

// ================================================================
// SECTION 9 — REVIEWS
// ================================================================

model reviews {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @updatedAt @db.Timestamp(6)

  booking_id         String    @db.Uuid
  venue_id           String    @db.Uuid
  court_id           String?   @db.Uuid
  user_id            String    @db.Uuid

  rating             Int
  rating_cleanliness Int?
  rating_facilities  Int?
  rating_staff       Int?
  comment            String?   @db.Text

  // Phản hồi từ owner/manager
  response           String?   @db.Text
  responded_by       String?   @db.Uuid // venue_staff.user_id (owner/manager)
  responded_at       DateTime? @db.Timestamp(6)

  // Kiểm duyệt bởi admin/staff platform
  is_visible         Boolean   @default(true)
  hidden_by          String?   @db.Uuid
  hidden_reason      String?

  bookings           bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  venues             venues    @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  courts             courts?   @relation(fields: [court_id], references: [id])
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  review_images      review_images[]

  @@unique([booking_id, user_id])
  @@index([venue_id])
  @@index([user_id])
  @@index([rating])
}

model review_images {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  review_id     String   @db.Uuid
  file_id       String   @db.Uuid
  display_order Int      @default(0)

  reviews       reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade)
  files         files    @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@index([review_id])
}

// ================================================================
// SECTION 10 — PROMOTIONS
// ================================================================

model promotions {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @updatedAt @db.Timestamp(6)
  deleted_at          DateTime?             @db.Timestamp(6)

  created_by          String?               @db.Uuid // admin/owner tạo promotion
  code                String                @unique @db.VarChar(50)
  name                String                @db.VarChar(255)
  description         String?
  discount_type       PromotionDiscountType
  discount_value      Decimal               @db.Decimal(10, 2)
  max_discount_amount Decimal?              @db.Decimal(10, 2)
  min_booking_amount  Decimal               @default(0) @db.Decimal(10, 2)
  usage_limit         Int?
  usage_count         Int                   @default(0)
  max_usage_per_user  Int                   @default(1)
  is_public           Boolean               @default(true)
  valid_from          DateTime              @db.Timestamp(6)
  valid_to            DateTime              @db.Timestamp(6)
  status              PromotionStatus       @default(ACTIVE)

  promotion_venues    promotion_venues[]
  promotion_courts    promotion_courts[]
  promotion_usage     promotion_usage[]
  user_vouchers       user_vouchers[]

  @@index([code])
  @@index([status])
  @@index([valid_from, valid_to])
}

model promotion_venues {
  promotion_id String     @db.Uuid
  venue_id     String     @db.Uuid

  promotions   promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  venues       venues     @relation(fields: [venue_id], references: [id])

  @@id([promotion_id, venue_id])
}

model promotion_courts {
  promotion_id String     @db.Uuid
  court_id     String     @db.Uuid

  promotions   promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  courts       courts     @relation(fields: [court_id], references: [id])

  @@id([promotion_id, court_id])
}

model promotion_usage {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at      DateTime   @default(now()) @db.Timestamp(6)
  promotion_id    String     @db.Uuid
  booking_id      String     @db.Uuid
  user_id         String     @db.Uuid
  discount_amount Decimal    @db.Decimal(10, 2)

  promotions      promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  bookings        bookings   @relation(fields: [booking_id], references: [id])
  users           users      @relation(fields: [user_id], references: [id])

  @@unique([promotion_id, booking_id])
  @@index([user_id])
}

model user_vouchers {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  user_id      String        @db.Uuid
  promotion_id String        @db.Uuid
  status       VoucherStatus @default(UNUSED)
  expires_at   DateTime?     @db.Timestamp(6)
  used_at      DateTime?     @db.Timestamp(6)

  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  promotions   promotions    @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  @@unique([user_id, promotion_id])
  @@index([status])
}

// ================================================================
// SECTION 11 — NOTIFICATIONS
// ================================================================

model notifications {
  id             String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime            @default(now()) @db.Timestamp(6)
  user_id        String              @db.Uuid
  type           NotificationType
  channel        NotificationChannel
  title          String              @db.VarChar(255)
  message        String              @db.Text
  reference_id   String?             @db.Uuid
  reference_type String?             @db.VarChar(50)
  is_read        Boolean             @default(false)
  read_at        DateTime?           @db.Timestamp(6)

  users          users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
}

// ================================================================
// SECTION 12 — FAVORITES
// ================================================================

model favorite_venues {
  user_id    String   @db.Uuid
  venue_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)

  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  venues     venues   @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@id([user_id, venue_id])
}

// ================================================================
// SECTION 13 — SUPPORT
// ================================================================

model support_tickets {
  id                String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at        DateTime              @default(now()) @db.Timestamp(6)
  updated_at        DateTime              @updatedAt @db.Timestamp(6)

  ticket_number     String                @unique @db.VarChar(20)
  customer_id       String                @db.Uuid // người tạo ticket (customer/owner)
  assigned_to_id    String?               @db.Uuid // admin/staff platform được assign
  assigned_at       DateTime?             @db.Timestamp(6)
  category          SupportTicketCategory @default(OTHER)
  priority          SupportTicketPriority @default(MEDIUM)
  status            SupportTicketStatus   @default(OPEN)
  subject           String                @db.VarChar(500)
  description       String                @db.Text
  booking_id        String?               @db.Uuid
  venue_id          String?               @db.Uuid
  resolution        String?               @db.Text
  resolved_at       DateTime?             @db.Timestamp(6)
  first_response_at DateTime?             @db.Timestamp(6)
  closed_at         DateTime?             @db.Timestamp(6)
  customer_rating   Int?
  customer_feedback String?

  customers         users                    @relation("ticket_customer", fields: [customer_id], references: [id], onDelete: Cascade)
  agents            users?                   @relation("ticket_agent", fields: [assigned_to_id], references: [id])
  bookings          bookings?                @relation(fields: [booking_id], references: [id])
  venues            venues?                  @relation(fields: [venue_id], references: [id])
  messages          support_ticket_messages[]

  @@index([customer_id])
  @@index([status])
  @@index([assigned_to_id])
  @@index([priority])
}

model support_ticket_messages {
  id         String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime        @default(now()) @db.Timestamp(6)
  ticket_id  String          @db.Uuid
  sender_id  String          @db.Uuid
  message    String          @db.Text
  is_staff   Boolean         @default(false) // true nếu là admin/staff platform

  tickets    support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  users      users           @relation(fields: [sender_id], references: [id])

  @@index([ticket_id])
}

// ================================================================
// SECTION 14 — REPORTS
// ================================================================

model reports {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime         @default(now()) @db.Timestamp(6)
  updated_at   DateTime         @updatedAt @db.Timestamp(6)
  reporter_id  String           @db.Uuid
  target_type  ReportTargetType
  target_id    String           @db.Uuid
  reason       ReportReason
  description  String?          @db.Text
  status       ReportStatus     @default(PENDING)
  reviewed_by  String?          @db.Uuid // admin/staff platform xử lý
  reviewed_at  DateTime?        @db.Timestamp(6)
  action_taken String?

  reporters    users            @relation("report_reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reviewers    users?           @relation("report_reviewer", fields: [reviewed_by], references: [id])

  @@index([reporter_id])
  @@index([target_type, target_id])
  @@index([status])
}

// ================================================================
// SECTION 15 — FRAUD DETECTION
// ================================================================

model fraud_detections {
  id                String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at        DateTime         @default(now()) @db.Timestamp(6)
  user_id           String?          @db.Uuid
  booking_id        String?          @db.Uuid
  risk_level        FraudRiskLevel
  risk_score        Decimal          @db.Decimal(5, 4)
  action_taken      FraudAction      @default(NONE)
  is_false_positive Boolean?
  reviewed_by       String?          @db.Uuid // admin/staff platform review
  reviewed_at       DateTime?        @db.Timestamp(6)
  notes             String?          @db.Text

  users             users?           @relation("fraud_subject", fields: [user_id], references: [id], onDelete: Cascade)
  bookings          bookings?        @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  reviewers         users?           @relation("fraud_reviewer", fields: [reviewed_by], references: [id])
  indicators        fraud_indicators[]

  @@index([user_id])
  @@index([booking_id])
  @@index([risk_level])
}

model fraud_indicators {
  id                 String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fraud_detection_id String           @db.Uuid
  indicator_type     String           @db.VarChar(100)
  indicator_value    String           @db.VarChar(500)
  severity           String           @db.VarChar(20)

  fraud_detections   fraud_detections @relation(fields: [fraud_detection_id], references: [id], onDelete: Cascade)

  @@index([fraud_detection_id])
}

// ================================================================
// SECTION 16 — SYSTEM
// ================================================================

model audit_logs {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  user_id     String?   @db.Uuid
  actor_role  String?   @db.VarChar(50) // 'super_admin'|'admin'|'staff'|'owner'|'venue_staff'|'customer'|'system'
  action      String    @db.VarChar(100)
  entity_name String    @db.VarChar(100)
  entity_id   String?   @db.Uuid
  old_values  String?   @db.Text
  new_values  String?   @db.Text
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.VarChar(500)

  users       users?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([entity_name, entity_id])
  @@index([action])
  @@index([created_at])
  @@index([actor_role])
}

model settings {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  data_type   String   @default("string") @db.VarChar(20)
  description String?
  is_active   Boolean  @default(true)
  group_name  String?  @db.VarChar(50)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  @@index([group_name])
}
