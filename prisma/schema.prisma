generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                           String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                   DateTime                  @default(now()) @db.Timestamp(6)
  updated_at                   DateTime                  @updatedAt @db.Timestamp(6)
  deleted_at                   DateTime?                 @db.Timestamp(6)
  email                        String                    @unique @db.VarChar(255)
  username                     String?                   @unique @db.VarChar(50)
  password                     String                    @db.VarChar(255)
  full_name                    String                    @db.VarChar(255)
  phone                        String?                   @unique @db.VarChar(20)
  avatar_url                   String?                   @db.VarChar(500)
  gender                       Gender?
  date_of_birth                DateTime?                 @db.Date
  status                       UserStatus                @default(ACTIVE)
  kyc_status                   KycStatus                 @default(UNVERIFIED)
  is_email_verified            Boolean                   @default(false)
  is_phone_verified            Boolean                   @default(false)
  email_verified_at            DateTime?                 @db.Timestamp(6)
  phone_verified_at            DateTime?                 @db.Timestamp(6)
  last_login_at                DateTime?                 @db.Timestamp(6)
  role_id                      String?                   @db.Uuid
  audit_logs                   audit_logs[]
  booking_addons_added         booking_addons[]          @relation("addon_added_by")
  booking_waitlist             booking_waitlist[]
  bookings_cancelled           bookings[]                @relation("booking_cancellation_staff")
  bookings_checked_in          bookings[]                @relation("booking_check_in_staff")
  bookings                     bookings[]
  commission_records_owned     commission_records[]      @relation("commission_owner")
  maintenance_created          court_maintenance[]       @relation("maintenance_creator")
  faqs                         faqs[]
  favorite_venues              favorite_venues[]
  files                        files[]
  invoices                     invoices[]
  notifications                notifications[]
  otp_verifications            otp_verifications[]
  payout_requests_proc         payout_requests[]         @relation("payout_processor")
  payout_requests_own          payout_requests[]         @relation("payout_owner")
  policies                     policies[]
  promotion_usage              promotion_usage[]
  promotions_created           promotions[]              @relation("promotion_creator")
  recurring_bookings           recurring_bookings[]
  refresh_tokens               refresh_tokens[]
  reports_submitted            reports[]                 @relation("report_reporter")
  reports_reviewed             reports[]                 @relation("report_reviewer")
  reviews_hidden               reviews[]                 @relation("review_hider")
  reviews_responded            reviews[]                 @relation("review_responder")
  reviews                      reviews[]
  search_history               search_history[]
  sport_types_created          sport_types[]             @relation("sport_type_creator")
  support_ticket_messages      support_ticket_messages[]
  support_tickets_as_agent     support_tickets[]         @relation("ticket_agent")
  support_tickets_as_customer  support_tickets[]         @relation("ticket_customer")
  transactions                 transactions[]
  devices                      user_devices[]
  referrals                    user_profiles[]           @relation("user_referrals")
  profile                      user_profiles?
  user_vouchers                user_vouchers[]
  role                         roles?                    @relation(fields: [role_id], references: [id])
  venue_staff_deactivated      venue_staff[]             @relation("staff_deactivator")
  venue_staff_invited          venue_staff[]             @relation("staff_inviter")
  venue_staff                  venue_staff[]
  venue_staff_invites_received venue_staff_invites[]     @relation("invite_receiver")
  venue_staff_invites_sent     venue_staff_invites[]     @relation("invite_sender")
  verifications_approved       venue_verifications[]     @relation("verification_approver")
  venues_approved              venues[]                  @relation("venue_approver")
  owned_venues                 venues[]
  wallet                       wallets?

  @@index([role_id])
  @@index([status])
  @@index([deleted_at])
}

model pending_registrations {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  email      String   @unique @db.VarChar(255)
  full_name  String   @db.VarChar(255)
  password   String   @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  code_hash  String   @db.VarChar(255)
  expires_at DateTime @db.Timestamp(6)
}

model user_profiles {
  id                String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at        DateTime                 @default(now()) @db.Timestamp(6)
  updated_at        DateTime                 @updatedAt @db.Timestamp(6)
  user_id           String                   @unique @db.Uuid
  bio               String?
  address           String?                  @db.VarChar(500)
  city              String?                  @db.VarChar(100)
  district          String?                  @db.VarChar(100)
  cover_url         String?                  @db.VarChar(500)
  latitude          Float?
  longitude         Float?
  reliability_score Int                      @default(100)
  show_email        Boolean                  @default(false)
  show_phone        Boolean                  @default(false)
  referral_code     String?                  @unique @db.VarChar(20)
  referred_by_id    String?                  @db.Uuid
  is_profile_public Boolean                  @default(true)
  notif_push        Boolean                  @default(true)
  notif_email       Boolean                  @default(true)
  notif_sms         Boolean                  @default(false)
  notif_booking     Boolean                  @default(true)
  notif_promotion   Boolean                  @default(true)
  notif_payment     Boolean                  @default(true)
  notif_system      Boolean                  @default(true)
  notif_staff       Boolean                  @default(true)
  referred_by       users?                   @relation("user_referrals", fields: [referred_by_id], references: [id])
  users             users                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sport_preferences user_sport_preferences[]

  @@index([user_id])
  @@index([referral_code])
}

model user_sport_preferences {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_profile_id String        @db.Uuid
  sport_type      String        @db.VarChar(50)
  skill_level     Int           @default(1) @db.SmallInt
  user_profiles   user_profiles @relation(fields: [user_profile_id], references: [id], onDelete: Cascade)

  @@unique([user_profile_id, sport_type])
  @@index([sport_type])
}

model user_devices {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  updated_at     DateTime     @updatedAt @db.Timestamp(6)
  user_id        String       @db.Uuid
  fcm_token      String       @unique @db.VarChar(500)
  app_version    String?      @db.VarChar(20)
  is_active      Boolean      @default(true)
  last_active_at DateTime     @default(now()) @db.Timestamp(6)
  device_type    AppPlatform?
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model refresh_tokens {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamp(6)
  is_revoked Boolean  @default(false)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(500)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model otp_verifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  user_id    String    @db.Uuid
  type       OtpType
  code_hash  String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  is_used    Boolean   @default(false)
  used_at    DateTime? @db.Timestamp(6)
  attempts   Int       @default(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
  @@index([expires_at])
}

model roles {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  name             String             @unique @db.VarChar(100)
  slug             String             @unique @db.VarChar(100)
  description      String?
  is_system        Boolean            @default(false)
  is_active        Boolean            @default(true)
  role_permissions role_permissions[]
  users            users[]
}

model permissions {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug             String             @unique @db.VarChar(100)
  resource         String             @db.VarChar(100)
  action           String             @db.VarChar(50)
  description      String?
  scope            PermissionScope    @default(PLATFORM)
  role_permissions role_permissions[]

  @@index([resource])
  @@index([scope])
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model files {
  id             String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime            @default(now()) @db.Timestamp(6)
  user_id        String?             @db.Uuid
  original_name  String              @db.VarChar(255)
  file_name      String              @db.VarChar(255)
  file_size      BigInt
  mime_type      String              @db.VarChar(100)
  storage_key    String?             @db.VarChar(500)
  bucket         String?             @db.VarChar(100)
  public_url     String              @db.VarChar(1000)
  width          Int?
  height         Int?
  banner_desktop banners[]           @relation("banner_desktop_file")
  banner_mobile  banners[]           @relation("banner_mobile_file")
  users          users?              @relation(fields: [user_id], references: [id])
  attachments    media_attachments[]

  @@index([user_id])
}

model media_attachments {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)
  file_id       String   @db.Uuid
  display_order Int      @default(0)
  is_cover      Boolean  @default(false)
  caption       String?  @db.VarChar(255)
  court_id      String?  @db.Uuid
  review_id     String?  @db.Uuid
  venue_id      String?  @db.Uuid
  courts        courts?  @relation(fields: [court_id], references: [id], onDelete: Cascade)
  files         files    @relation(fields: [file_id], references: [id], onDelete: Cascade)
  reviews       reviews? @relation(fields: [review_id], references: [id], onDelete: Cascade)
  venues        venues?  @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@index([venue_id])
  @@index([court_id])
  @@index([review_id])
  @@index([file_id])
}

model venues {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @updatedAt @db.Timestamp(6)
  deleted_at                DateTime?                   @db.Timestamp(6)
  owner_id                  String                      @db.Uuid
  name                      String                      @db.VarChar(255)
  slug                      String                      @unique @db.VarChar(255)
  description               String?
  address                   String                      @db.VarChar(500)
  city                      String                      @db.VarChar(100)
  district                  String                      @db.VarChar(100)
  ward                      String?                     @db.VarChar(100)
  phone                     String?                     @db.VarChar(20)
  email                     String?                     @db.VarChar(255)
  thumbnail_url             String?                     @db.VarChar(500)
  fb_url                    String?                     @db.VarChar(500)
  instagram_url             String?                     @db.VarChar(500)
  zalo_url                  String?                     @db.VarChar(500)
  youtube_url               String?                     @db.VarChar(500)
  latitude                  Float?
  longitude                 Float?
  status                    VenueStatus                 @default(PENDING)
  rejection_reason          String?
  is_active                 Boolean                     @default(true)
  is_featured               Boolean                     @default(false)
  featured_until            DateTime?                   @db.Timestamp(6)
  rating                    Decimal                     @default(0) @db.Decimal(3, 2)
  rating_cleanliness        Decimal                     @default(0) @db.Decimal(3, 2)
  rating_facilities         Decimal                     @default(0) @db.Decimal(3, 2)
  rating_staff              Decimal                     @default(0) @db.Decimal(3, 2)
  total_reviews             Int                         @default(0)
  commission_rate           Decimal                     @default(0) @db.Decimal(5, 2)
  vat_rate                  Decimal                     @default(0) @db.Decimal(5, 2)
  auto_accept_bookings      Boolean                     @default(true)
  min_booking_hours         Int                         @default(1)
  max_booking_hours         Int                         @default(24)
  min_booking_before_hours  Int                         @default(0)
  cancellation_before_hours Int                         @default(24)
  admin_notes               String?
  approved_at               DateTime?                   @db.Timestamp(6)
  approved_by               String?                     @db.Uuid
  amenities                 amenities[]
  banners                   banners[]                   @relation("banner_venue")
  bookings                  bookings[]
  commission_records        commission_records[]
  courts                    courts[]
  favorite_venues           favorite_venues[]
  media_attachments         media_attachments[]
  promotion_venues          promotion_venues[]
  recurring_bookings        recurring_bookings[]
  refund_policies           refund_policies[]
  reviews                   reviews[]
  sport_assignments         sport_assignments[]
  support_tickets           support_tickets[]
  venue_operating_hours     venue_operating_hours[]
  venue_schedule_exceptions venue_schedule_exceptions[]
  venue_services            venue_services[]
  venue_staff               venue_staff[]
  venue_staff_invites       venue_staff_invites[]
  venue_verifications       venue_verifications[]
  admin_approver            users?                      @relation("venue_approver", fields: [approved_by], references: [id])
  users                     users                       @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id])
  @@index([status])
  @@index([city])
  @@index([district])
  @@index([is_featured])
  @@index([deleted_at])
}

model sport_types {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  name       String   @unique @db.VarChar(50)
  label      String   @db.VarChar(100)
  icon       String?  @db.VarChar(100)
  is_system  Boolean  @default(true)
  is_active  Boolean  @default(true)
  created_by String?  @db.Uuid
  creator    users?   @relation("sport_type_creator", fields: [created_by], references: [id])
}

model sport_assignments {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sport_type String  @db.VarChar(50)
  court_id   String? @db.Uuid
  venue_id   String? @db.Uuid
  courts     courts? @relation(fields: [court_id], references: [id], onDelete: Cascade)
  venues     venues? @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, sport_type])
  @@unique([court_id, sport_type])
  @@index([sport_type])
}

model amenities {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name     String  @db.VarChar(100)
  icon     String? @db.VarChar(100)
  is_free  Boolean @default(true)
  court_id String? @db.Uuid
  venue_id String? @db.Uuid
  courts   courts? @relation(fields: [court_id], references: [id], onDelete: Cascade)
  venues   venues? @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, name])
  @@unique([court_id, name])
  @@index([venue_id])
  @@index([court_id])
}

model venue_operating_hours {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  venue_id     String    @db.Uuid
  day_of_week  DayOfWeek
  opening_time DateTime  @db.Time(6)
  closing_time DateTime  @db.Time(6)
  is_closed    Boolean   @default(false)
  venues       venues    @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, day_of_week])
}

model venue_schedule_exceptions {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  venue_id   String    @db.Uuid
  date       DateTime  @db.Date
  is_closed  Boolean   @default(true)
  open_time  DateTime? @db.Time(6)
  close_time DateTime? @db.Time(6)
  reason     String?   @db.VarChar(255)
  venues     venues    @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, date])
  @@index([date])
}

model venue_verifications {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime           @default(now()) @db.Timestamp(6)
  updated_at           DateTime           @updatedAt @db.Timestamp(6)
  venue_id             String             @db.Uuid
  business_license_url String             @db.VarChar(500)
  id_card_front_url    String             @db.VarChar(500)
  id_card_back_url     String             @db.VarChar(500)
  owner_photo_url      String             @db.VarChar(500)
  status               VerificationStatus @default(PENDING)
  verified_at          DateTime?          @db.Timestamp(6)
  verified_by          String?            @db.Uuid
  rejection_reason     String?
  version              Int                @default(1)
  venues               venues             @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  admin_approver       users?             @relation("verification_approver", fields: [verified_by], references: [id])

  @@index([venue_id])
  @@index([status])
}

model venue_staff {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  updated_at       DateTime       @updatedAt @db.Timestamp(6)
  venue_id         String         @db.Uuid
  user_id          String         @db.Uuid
  role             VenueStaffRole @default(STAFF)
  is_active        Boolean        @default(true)
  invited_by       String?        @db.Uuid
  joined_at        DateTime?      @db.Timestamp(6)
  deactivated_at   DateTime?      @db.Timestamp(6)
  deactivated_by   String?        @db.Uuid
  work_start_time  DateTime?      @db.Time(6)
  work_end_time    DateTime?      @db.Time(6)
  note             String?        @db.VarChar(500)
  work_days        DayOfWeek[]
  deactivator_user users?         @relation("staff_deactivator", fields: [deactivated_by], references: [id])
  inviter          users?         @relation("staff_inviter", fields: [invited_by], references: [id])
  users            users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  venues           venues         @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([venue_id, user_id])
  @@index([venue_id])
  @@index([user_id])
  @@index([role])
  @@index([is_active])
}

model venue_staff_invites {
  id           String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime               @default(now()) @db.Timestamp(6)
  updated_at   DateTime               @updatedAt @db.Timestamp(6)
  venue_id     String                 @db.Uuid
  sender_id    String                 @db.Uuid
  receiver_id  String?                @db.Uuid
  invite_email String                 @db.VarChar(255)
  role         VenueStaffRole         @default(STAFF)
  token        String                 @unique @db.VarChar(100)
  expires_at   DateTime               @db.Timestamp(6)
  status       VenueStaffInviteStatus @default(PENDING)
  message      String?                @db.VarChar(500)
  responded_at DateTime?              @db.Timestamp(6)
  receiver     users?                 @relation("invite_receiver", fields: [receiver_id], references: [id])
  sender       users                  @relation("invite_sender", fields: [sender_id], references: [id])
  venues       venues                 @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@index([venue_id])
  @@index([invite_email])
  @@index([expires_at])
  @@index([status])
}

model venue_services {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @updatedAt @db.Timestamp(6)
  venue_id        String           @db.Uuid
  name            String           @db.VarChar(255)
  description     String?
  price           Decimal          @db.Decimal(15, 2)
  type            VenueServiceType @default(SERVICE)
  category        String?          @db.VarChar(100)
  is_available    Boolean          @default(true)
  track_inventory Boolean          @default(false)
  stock_quantity  Int              @default(0)
  unit            ServiceUnit      @default(UNIT)
  booking_addons  booking_addons[]
  venues          venues           @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@index([venue_id])
}

model courts {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  deleted_at         DateTime?            @db.Timestamp(6)
  venue_id           String               @db.Uuid
  name               String               @db.VarChar(255)
  description        String?
  price_per_hour     Decimal              @db.Decimal(10, 2)
  surface_type       CourtSurfaceType?
  size               String?              @db.VarChar(50)
  is_indoor          Boolean              @default(false)
  is_active          Boolean              @default(true)
  thumbnail_url      String?              @db.VarChar(500)
  display_order      Int                  @default(0)
  amenities          amenities[]
  booking_waitlist   booking_waitlist[]
  bookings           bookings[]
  court_maintenance  court_maintenance[]
  venues             venues               @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  media_attachments  media_attachments[]
  pricing_rules      pricing_rules[]
  recurring_bookings recurring_bookings[]
  reviews            reviews[]
  sport_assignments  sport_assignments[]

  @@index([venue_id])
  @@index([is_active])
  @@index([deleted_at])
}

model court_maintenance {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamp(6)
  court_id     String   @db.Uuid
  start_at     DateTime @db.Timestamp(6)
  end_at       DateTime @db.Timestamp(6)
  reason       String   @db.VarChar(500)
  is_emergency Boolean  @default(false)
  created_by   String?  @db.Uuid
  courts       courts   @relation(fields: [court_id], references: [id], onDelete: Cascade)
  creator      users?   @relation("maintenance_creator", fields: [created_by], references: [id])

  @@index([court_id])
  @@index([start_at])
}

model pricing_rules {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)
  court_id    String     @db.Uuid
  name        String?    @db.VarChar(100)
  day_of_week DayOfWeek?
  start_time  DateTime   @db.Time(6)
  end_time    DateTime   @db.Time(6)
  price       Decimal    @db.Decimal(10, 2)
  start_date  DateTime?  @db.Date
  end_date    DateTime?  @db.Date
  priority    Int        @default(1)
  is_active   Boolean    @default(true)
  courts      courts     @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@index([court_id])
  @@index([day_of_week])
  @@index([is_active])
}

model bookings {
  id                     String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @updatedAt @db.Timestamp(6)
  deleted_at             DateTime?                @db.Timestamp(6)
  booking_code           String                   @unique @db.VarChar(20)
  check_in_code          String?                  @unique @db.VarChar(10)
  customer_id            String                   @db.Uuid
  court_id               String                   @db.Uuid
  venue_id               String                   @db.Uuid
