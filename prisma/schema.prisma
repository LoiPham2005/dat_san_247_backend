// ================================================================
// PRISMA SCHEMA — Sports Court Booking Platform v6
// Production-Ready | PostgreSQL | Commercial Optimized
// 57 models | 6 Roles: super_admin, admin, staff, owner, venue_staff, customer
//
// TỐI ƯU TỪ doc3 (v5 mở rộng):
//   BỎ  blog_posts          → không cần cho MVP đặt sân
//   BỎ  content_tags        → phụ thuộc blog_posts
//   BỎ  email_templates     → dùng Sendgrid/Brevo, thêm sau khi cần
//   BỎ  time_slots          → trùng logic với bookings + pricing_rules
//   GỘP venue_sport_types
//       + court_sport_types → sport_assignments (entity_type VENUE/COURT)
//   GỘP venue_amenities
//       + court_amenities   → amenities (entity_type VENUE/COURT)
//   THÊM holiday_calendar   → lịch ngày lễ + hệ số giá VN
//   THÊM commission_records → track hoa hồng từng booking
//   THÊM search_history     → analytics + gợi ý sân
//   THÊM app_versions       → force update mobile app
//   FIX  users.is_active    → bỏ (trùng status)
//   FIX  users reset_password fields → bỏ (dùng otp_verifications)
//   FIX  files.r2_key       → bỏ (trùng storage_key)
//   FIX  files.target_type/id → bỏ (đã có media_attachments)
//   FIX  venues.opening_time/closing_time → bỏ (có venue_operating_hours)
//   FIX  bookings.platform_fee → bỏ (= commission_amount)
//   FIX  notifications.data Json → bỏ (reference_id đủ rồi)
//   FIX  contents.type String → đổi thành enum ContentType
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// ENUMS
// ================================================================

