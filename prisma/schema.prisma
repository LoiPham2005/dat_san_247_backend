  price_multiplier Decimal  @default(1.5) @db.Decimal(5, 2)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  recurring_day    Int?
  recurring_month  Int?

  @@index([holiday_date])
  @@index([is_active])
}

model search_history {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  user_id      String?   @db.Uuid
  search_query String    @db.VarChar(300)
  sport_type   String?   @db.VarChar(50)
  city         String?   @db.VarChar(100)
  district     String?   @db.VarChar(100)
  search_date  DateTime? @db.Date
  result_count Int       @default(0)
  users        users?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([sport_type])
  @@index([created_at])
}

model app_versions {
  id                    String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  version_number        String      @db.VarChar(20)
  build_number          Int
  min_supported_version String?     @db.VarChar(20)
  is_force_update       Boolean     @default(false)
  release_notes         String?
  download_url          String?     @db.VarChar(500)
  is_active             Boolean     @default(true)
  released_at           DateTime?   @db.Timestamp(6)
  created_at            DateTime    @default(now()) @db.Timestamp(6)
  platform              AppPlatform

  @@unique([platform, version_number])
  @@index([platform, is_active])
}

model faqs {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @updatedAt @db.Timestamp(6)
  category      FaqCategory
  question      String      @db.VarChar(500)
  answer        String
  display_order Int         @default(0)
  is_active     Boolean     @default(true)
  author_id     String?     @db.Uuid
  author        users?      @relation(fields: [author_id], references: [id])

  @@index([category])
  @@index([is_active])
}

model policies {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at          DateTime   @default(now()) @db.Timestamp(6)
  updated_at          DateTime   @updatedAt @db.Timestamp(6)
  type                PolicyType
  is_current          Boolean    @default(true)
  title               String     @db.VarChar(255)
  content             String
  version             String     @db.VarChar(50)
  effective_date      DateTime   @db.Timestamp(6)
  requires_acceptance Boolean    @default(false)
  author_id           String?    @db.Uuid
  author              users?     @relation(fields: [author_id], references: [id])

  @@index([type])
  @@index([type, is_current])
}

model banners {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  updated_at          DateTime         @updatedAt @db.Timestamp(6)
  mobile_file_id      String?          @db.Uuid
  action_url          String?          @db.VarChar(500)
  action_venue_id     String?          @db.Uuid
  action_promotion_id String?          @db.Uuid
  start_date          DateTime         @db.Timestamp(6)
  end_date            DateTime?        @db.Timestamp(6)
  impressions         Int              @default(0)
  clicks              Int              @default(0)
  auto_slide          Boolean          @default(true)
  slide_duration      Int              @default(5000)
  desktop_file_id     String?          @db.Uuid
  display_order       Int              @default(0)
  is_active           Boolean          @default(true)
  title               String           @db.VarChar(255)
  position            BannerPosition
  type                BannerType
  action_type         BannerActionType @default(NONE)
  banner_pages        banner_pages[]
  action_promotion    promotions?      @relation("banner_promotion", fields: [action_promotion_id], references: [id])
  action_venue        venues?          @relation("banner_venue", fields: [action_venue_id], references: [id])
  desktop_file        files?           @relation("banner_desktop_file", fields: [desktop_file_id], references: [id])
  mobile_file         files?           @relation("banner_mobile_file", fields: [mobile_file_id], references: [id])

  @@index([is_active])
  @@index([position])
}

model banner_pages {
  id        String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  banner_id String     @db.Uuid
  page      BannerPage
  banners   banners    @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  @@unique([banner_id, page])
  @@index([page])
}

