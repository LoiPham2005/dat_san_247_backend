model ai_models {
  id                        String                @id(map: "PK_69a15349ca5e00f8e36ec17a8f8") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                DateTime              @default(now()) @db.Timestamp(6)
