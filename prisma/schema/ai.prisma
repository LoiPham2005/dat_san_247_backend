  bookings                                     bookings?                             @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_197ab7af18c93fbb0c9b28b4a595")
  users_ai_fraud_detections_reviewed_byTousers users?                                @relation("ai_fraud_detections_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_da722d93356ae3119d6be40d9885")

  @@index([user_id], map: "IDX_0b23f38ec436cb9787d510be67")
}

model ai_image_analysis {
  id                  String                                   @id(map: "PK_1475170bee3dd98b53e8aa7dd1a") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at          DateTime                                 @default(now()) @db.Timestamp(6)
  updated_at          DateTime                                 @default(now()) @db.Timestamp(6)
  deleted_at          DateTime?                                @db.Timestamp(6)
  file_id             String                                   @db.Uuid
  analysis_type       ai_image_analysis_analysis_type_enum
  results             Json
