model ai_assistance {
  id               String                  @id(map: "PK_51c682ea69b129755db97f28246") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime                @default(now()) @db.Timestamp(6)
  updated_at       DateTime                @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?               @db.Timestamp(6)
  user_id          String?                 @db.Uuid
  booking_id       String?                 @db.Uuid
  type             ai_assistance_type_enum
  target_entity    String?                 @db.VarChar
  target_entity_id String?                 @db.Uuid
  title            String
  content          String?
  payload          Json?
  confidence       Decimal                 @default(1) @db.Decimal(5, 4)
  is_read          Boolean                 @default(false)
  is_actioned      Boolean                 @default(false)
  bookings         bookings?               @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ai_assistance_booking")
  users            users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a0983237e62f3a8d153078a8129")

  @@index([user_id], map: "IDX_a0983237e62f3a8d153078a812")
}

model ai_cache {
