  created_at   DateTime   @default(now()) @db.Timestamp(6)
  updated_at   DateTime   @default(now()) @db.Timestamp(6)
  model_id     String     @db.Uuid
  query_hash   String     @unique(map: "UQ_36d1b72fc4771960205d15c8e31") @db.VarChar
