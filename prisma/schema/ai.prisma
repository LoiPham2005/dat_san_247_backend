model ai_assistance {
  id               String                  @id(map: "PK_51c682ea69b129755db97f28246") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime                @default(now()) @db.Timestamp(6)
  updated_at       DateTime                @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?               @db.Timestamp(6)
  user_id          String                  @db.Uuid
  type             ai_assistance_type_enum
  question         String
  answer           Json
  context          Json?
  rating           Int?
  feedback         String?
  users            users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a0983237e62f3a8d153078a8123")

  @@index([user_id], map: "IDX_a0983237e62f3a8d153078a812")
}

model ai_cache {
  id           String     @id(map: "PK_30b792e08262273016a05f34517") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamp(6)
  updated_at   DateTime   @default(now()) @db.Timestamp(6)
  cache_key    String     @unique(map: "UQ_9f59baef086138cc08e67be58ce") @db.VarChar
  prompt_hash  String     @db.VarChar
  feature_code String     @db.VarChar
  model_id     String     @db.Uuid
  response     Json
  input_tokens Int        @default(0)
  output_tokens Int       @default(0)
  expires_at   DateTime   @db.Timestamp(6)
  hit_count    Int        @default(0)

  @@index([expires_at], map: "IDX_312f8b7d101835c1e0423b4cf8")
  @@index([model_id], map: "IDX_88ea941e8ba614b919b802053d")
  @@index([feature_code], map: "IDX_912b211e63ffe3f1a3d7f29440")
  @@index([cache_key], map: "IDX_9f59baef086138cc08e67be58c")
}

model ai_conversations {
  id                                                  String                          @id(map: "PK_60db12765b82858ba00c8aa4ae2") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                                          DateTime                        @default(now()) @db.Timestamp(6)
  updated_at                                          DateTime                        @default(now()) @db.Timestamp(6)
  deleted_at                                          DateTime?                       @db.Timestamp(6)
  user_id                                             String?                         @db.Uuid
  title                                               String?                         @db.VarChar
  status                                              ai_conversations_status_enum    @default(ACTIVE)
  summary                                             String?
  sentiment                                           ai_conversations_sentiment_enum @default(NEUTRAL)
  metadata                                            Json?
  escalated_to_agent_id                               String?                         @db.Uuid
  escalated_at                                        DateTime?                       @db.Timestamp(6)
  resolved_at                                         DateTime?                       @db.Timestamp(6)
  users_ai_conversations_escalated_to_agent_idTousers users?                          @relation("ai_conversations_escalated_to_agent_idTousers", fields: [escalated_to_agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_06c564c515d8cdb40b6f3bfbbb42")
  users_ai_conversations_user_idTousers               users?                          @relation("ai_conversations_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_12fdbf99ca0da93085d61edd3bb")
  ai_messages                                         ai_messages[]

  @@index([user_id], map: "IDX_12fdbf99ca0da93085d61edd3b")
}

model ai_feedback {
  id            String      @id(map: "PK_aa34b6654c98bf014129c13c1b0") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @default(now()) @db.Timestamp(6)
  user_id       String      @db.Uuid
  interaction_id String?     @db.Uuid
  rating        Int
  comment       String?
  entity_type   String?     @db.VarChar
  entity_id     String?     @db.Uuid
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_92a7f08baacc8317fcebb7d8ec8")
}

model ai_fraud_detections {
