  ai_feedback               ai_feedback[]
  ai_interactions           ai_interactions[]

  @@index([model_type], map: "IDX_41afdcb44aa3e72d74033462d1")
  @@index([provider], map: "IDX_6d3ea7c98f14266a28684a73d3")
  @@index([status], map: "IDX_7d576a1dc563494e7456d61278")
  @@index([name], map: "IDX_b2e64c27a46f4707b83ea5ee75")
}

