model contents {
  id                 String                    @id(map: "PK_cb0f885278d12384eb7a81818bf") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime                  @default(now()) @db.Timestamp(6)
  updated_at         DateTime                  @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?                 @db.Timestamp(6)
  type               String                    @db.VarChar(50)
  title              String                    @db.VarChar(255)
  slug               String?                   @unique(map: "UQ_9fd71efb7abb246a69847399d15") @db.VarChar(255)
  description        String?                   @db.Text
  content            String                    @db.Text
  excerpt            String?                   @db.Text
  thumbnail_file_id  String?                   @db.Uuid
  thumbnail_url      String?                   @db.VarChar(255)
  status             contents_status_enum      @default(DRAFT)
  published_at       DateTime?                 @db.Timestamp(6)
  scheduled_at       DateTime?                 @db.Timestamp(6)
  expired_at         DateTime?                 @db.Timestamp(6)
  valid_from         DateTime?                 @db.Timestamp(6)
  valid_to           DateTime?                 @db.Timestamp(6)
  seo_title          String?                   @db.VarChar(255)
  seo_description    String?                   @db.Text
  seo_keywords       Json?
  display_order      Int                       @default(0)
  author_id          String?                   @db.Uuid
  author_type        String                    @default("ADMIN") @db.VarChar(20)
  parent_id          String?                   @db.Uuid
  is_featured        Boolean                   @default(false)
  is_pinned          Boolean                   @default(false)
  view_count         Int                       @default(0)
  target_audience    contents_target_audience_enum @default(ALL)
  target_user_ids    Json?
  target_regions     Json?
  metadata           Json?
  tags               Json?
  categories         Json?

  author             users?                    @relation("contents_author", fields: [author_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_contents_author")
  parent             contents?                 @relation("contentsTocontents", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_contents_parent")
  children           contents[]                @relation("contentsTocontents")
  thumbnail          files?                    @relation(fields: [thumbnail_file_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_contents_thumbnail")

  banners            banners?
  blog_posts         blog_posts?
  faqs               faqs?
  policies           policies?
  email_templates    email_templates?
  promotion_contents promotion_contents?

  @@index([status], map: "IDX_contents_status")
  @@index([slug], map: "IDX_contents_slug")
  @@index([type], map: "IDX_contents_type")
}

