  total_reviews             Int                         @default(0)
  is_featured               Boolean                     @default(false)
  featured_until            DateTime?                   @db.Timestamp(6)
  commission_rate           Decimal                     @default(0) @db.Decimal(5, 2)
  rating_cleanliness        Decimal                     @default(0) @db.Decimal(3, 2)
  rating_facilities         Decimal                     @default(0) @db.Decimal(3, 2)
  rating_staff              Decimal                     @default(0) @db.Decimal(3, 2)
  search_keywords           Json?
  vat_rate                  Decimal                     @default(0) @db.Decimal(5, 2)
  business_type             String?                     @db.VarChar
  is_active                 Boolean                     @default(true)
  social_links              Json?
  auto_accept_bookings      Boolean                     @default(true)
  min_booking_before_hours  Int                         @default(0)
  cancellation_before_hours Int                         @default(24)
  amenities                 Json?
  ai_recommendations        ai_recommendations[]
  ai_search_rankings        ai_search_rankings[]
  bookings                  bookings[]
  chat_conversations        chat_conversations[]
  courts                    courts[]
  favorite_venues           favorite_venues[]
  match_findings            match_findings[]
  posts                     posts[]
  promotion_venues          promotion_venues[]
  recurring_bookings        recurring_bookings[]
  refund_policies           refund_policies[]
  reviews                   reviews[]
  staff_shifts              staff_shifts[]
  support_tickets           support_tickets[]
  tournaments               tournaments[]
  user_behaviors            user_behaviors[]
  venue_blacklist           venue_blacklist[]
  venue_images              venue_images[]
  venue_memberships         venue_memberships[]
  venue_operating_hours     venue_operating_hours[]
  venue_revenue_snapshots   venue_revenue_snapshots[]
  venue_schedule_exceptions venue_schedule_exceptions[]
  venue_services            venue_services[]
  venue_staff               venue_staff[]
  venue_verifications       venue_verifications[]
  users                     users                       @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8cb5cf3df16fc75663f85b5b35c")
  organizations             organizations?              @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_d88176e38bb768c1c09d3a5f2e2")

  @@index([status], map: "IDX_305893adfc2e10604afde59eed")
  @@index([district], map: "IDX_30726f3240968282a8e586710a")
  @@index([is_featured], map: "IDX_4f62fe50d67d3991eef9f3794f")
  @@index([owner_id], map: "IDX_8cb5cf3df16fc75663f85b5b35")
  @@index([slug], map: "IDX_9fd71efb7abb246a69847399d1")
  @@index([city], map: "IDX_d335f0db6f08101c867272fc90")
  @@index([organization_id], map: "IDX_d88176e38bb768c1c09d3a5f2e")
}

