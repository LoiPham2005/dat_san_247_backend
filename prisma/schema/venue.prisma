  latitude                  Decimal?                    @db.Decimal(10, 8)
  longitude                 Decimal?                    @db.Decimal(11, 8)
  phone                     String?                     @db.VarChar
  email                     String?                     @db.VarChar
  status                    venues_status_enum          @default(PENDING)
  rejection_reason          String?
  thumbnail_url             String?
