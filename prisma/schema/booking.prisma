// ============================================================
// Booking Module
// ============================================================

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model booking_addons {
  id          String         @id(map: "PK_0b4ec998ba8e62da8673df0f540") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  updated_at  DateTime       @default(now()) @db.Timestamp(6)
  booking_id  String         @db.Uuid
  service_id  String         @db.Uuid
  quantity    Int            @default(1)
  unit_price  Decimal        @db.Decimal(10, 2)
  total_price Decimal        @db.Decimal(10, 2)
  bookings    bookings       @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d8a83c1d8844dc9ed046cd52140")

  @@index([service_id], map: "IDX_0b4ec998ba8e62da8673df0f54")
  @@index([booking_id], map: "IDX_d8a83c1d8844dc9ed046cd5214")
}

model booking_status_history {
  id         String                             @id(map: "PK_589851c586ac15a59462092c0cd") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime                           @default(now()) @db.Timestamp(6)
  booking_id String                             @db.Uuid
  status     booking_status_history_status_enum
  note       String?
  changed_by String?                            @db.Uuid
  bookings   bookings                           @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_f274364cc4e753ce257fa0e0600")
  users      users?                             @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_f274364cc4e753ce257fa0e0601")

  @@index([booking_id], map: "IDX_f274364cc4e753ce257fa0e060")
}

model booking_waitlist {
  id           String                       @id(map: "PK_e369c3fe5167c4fb372451aa870") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime                     @default(now()) @db.Timestamp(6)
  updated_at   DateTime                     @default(now()) @db.Timestamp(6)
  venue_id     String                       @db.Uuid
  court_id     String                       @db.Uuid
  user_id      String                       @db.Uuid
  booking_date DateTime                     @db.Date
  start_time   DateTime                     @db.Time(6)
  end_time     DateTime                     @db.Time(6)
  status       String                       @default("WAITING") @db.VarChar
  courts       courts                       @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_41afdcb44aa3e72d74033462d1c")
  users        users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ba0ff437a7654b523c3203009a2")

  @@index([user_id], map: "IDX_ba0ff437a7654b523c3203009a")
}

model bookings {
  id                     String                   @id(map: "PK_bee6805982cc1e248e94ce94957") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at             DateTime?                @db.Timestamp(6)
  venue_id               String                   @db.Uuid
  court_id               String                   @db.Uuid
  customer_id            String                   @db.Uuid
  booking_date           DateTime                 @db.Date
  start_time             DateTime                 @db.Time(6)
  end_time               DateTime                 @db.Time(6)
  status                 bookings_status_enum     @default(PENDING)
  payment_status         bookings_payment_status_enum @default(UNPAID)
  booking_code           String                   @unique(map: "UQ_796e0227e4beff186bdd72ac536") @db.VarChar
  check_in_code          String?                  @unique(map: "UQ_b7178816413d9383e2d5bc64e22") @db.VarChar(10)
  price_per_hour         Decimal                  @db.Decimal(10, 2)
  total_amount           Decimal                  @db.Decimal(10, 2)
  sub_total              Decimal                  @default(0) @db.Decimal(10, 2)
  discount_amount        Decimal                  @default(0) @db.Decimal(10, 2)
  vat_amount             Decimal                  @default(0) @db.Decimal(10, 2)
  vat_rate               Decimal                  @default(0) @db.Decimal(5, 2)
  cancellation_deadline  DateTime?                @db.Timestamp(6)
  cancellation_fee       Decimal                  @default(0) @db.Decimal(10, 2)
  refund_amount          Decimal                  @default(0) @db.Decimal(10, 2)
  notes                  String?
  is_recurring           Boolean                  @default(false)
  recurring_booking_id   String?                  @db.Uuid
  check_in_at            DateTime?                @db.Timestamp(6)
  check_out_at           DateTime?                @db.Timestamp(6)
  cancelled_at           DateTime?                @db.Timestamp(6)
  cancelled_by           String?                  @db.VarChar
  cancellation_reason    String?
  ai_fraud_detections    ai_fraud_detections[]
  booking_addons         booking_addons[]
  booking_status_history booking_status_history[]
  courts                 courts                   @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_2bd7e9c03db9f51a4765974abb8")
  users                  users                    @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_8e21b7ae33e7b0673270de41463")
  recurring_bookings     recurring_bookings?      @relation(fields: [recurring_booking_id], references: [id], onUpdate: NoAction, map: "FK_b7178816413d9383e2d5bc64e23")
  venues                 venues                   @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_bee6805982cc1e248e94ce94957")
  invoices               invoices[]
  match_results          match_results[]
  payments               payments[]
  posts                  posts[]
  promotion_usage        promotion_usage[]
  reviews                reviews[]
  support_tickets        support_tickets[]
  transactions           transactions[]

  @@index([booking_date], map: "IDX_0b43f68def0b753efccd9aa68c")
  @@index([court_id], map: "IDX_2bd7e9c03db9f51a4765974abb")
  @@index([status], map: "IDX_48b267d894e32a25ebde4b207a")
  @@index([booking_code], map: "IDX_796e0227e4beff186bdd72ac53")
  @@index([customer_id], map: "IDX_8e21b7ae33e7b0673270de4146")
  @@index([venue_id], map: "IDX_9285e4f67f013d21d8d9905b1e")
  @@index([check_in_code], map: "IDX_b7178816413d9383e2d5bc64e2")
}

model recurring_bookings {
  id                  String                             @id(map: "PK_2002148c2a9c90455a4281b370d") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at          DateTime                           @default(now()) @db.Timestamp(6)
  updated_at          DateTime                           @default(now()) @db.Timestamp(6)
  deleted_at          DateTime?                          @db.Timestamp(6)
  user_id             String                             @db.Uuid
  venue_id            String                             @db.Uuid
  court_id            String                             @db.Uuid
  repeatType          recurring_bookings_repeattype_enum @default(WEEKLY)
  days_of_week        Json?
  start_time          DateTime                           @db.Time(6)
  end_time            DateTime                           @db.Time(6)
  start_date          DateTime                           @db.Date
  end_date            DateTime?                          @db.Date
  is_active           Boolean                            @default(true)
  last_generated_date DateTime?                          @db.Date
  bookings            bookings[]
  courts              courts                             @relation(fields: [court_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_573718a9853629611b24aa9fca9")
  users               users                              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_69a8202b934fefca0335bb74048")
  venues              venues                             @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_dba2a28587e6586e119d46665e2")

  @@index([user_id], map: "IDX_69a8202b934fefca0335bb7404")
  @@index([venue_id], map: "IDX_dba2a28587e6586e119d46665e")
}

// ============================================================
// Booking Enums
// ============================================================

enum recurring_bookings_repeattype_enum {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum booking_status_history_status_enum {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum bookings_payment_status_enum {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum bookings_status_enum {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
