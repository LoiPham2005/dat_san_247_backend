// ============================================================
// Payment Module
// ============================================================

model invoice_items {
  id           String                 @id(map: "PK_invoice_items") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime               @default(now()) @db.Timestamp(6)
  updated_at   DateTime               @default(now()) @db.Timestamp(6)
  invoice_id   String                 @db.Uuid
  description  String                 @db.VarChar
  amount       Decimal                @db.Decimal(15, 2)
  quantity     Int                    @default(1)
  unit_price   Decimal                @db.Decimal(15, 2)
  type         invoice_items_type_enum @default(OTHER)
  reference_id String?                @db.Uuid
  invoices     invoices               @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_invoice_items_invoices")

  @@index([invoice_id])
  @@index([reference_id])
}

model invoices {
  id             String               @id(map: "PK_668cef7c22a427fd822cc1be3ce") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime             @default(now()) @db.Timestamp(6)
  updated_at     DateTime             @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?            @db.Timestamp(6)
  invoice_number String               @unique(map: "UQ_d8f8d3788694e1b3f96c42c36fb") @db.VarChar
  customer_id    String               @db.Uuid
  booking_id     String?              @db.Uuid
  transaction_id String?              @db.Uuid
  total_amount   Decimal              @db.Decimal(15, 2)
  sub_total      Decimal              @db.Decimal(15, 2)
  tax_amount     Decimal              @default(0) @db.Decimal(15, 2)
  discount_amount Decimal              @default(0) @db.Decimal(15, 2)
  currency       String               @default("VND") @db.VarChar(10)
  status         invoices_status_enum @default(PENDING)
  due_date       DateTime?            @db.Timestamp(6)
  paid_at        DateTime?            @db.Timestamp(6)
  invoice_items  invoice_items[]
  transactions   transactions?        @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_6abcea98097ae84c138c1db301b")
  users          users                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ac0f09364e3701d9ed35435288b")
  bookings       bookings?            @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ed9c7aa7846704bbcb648377e8f")

  @@index([customer_id], map: "IDX_65e3145f317bd655481d3f96c7")
  @@index([transaction_id], map: "IDX_6abcea98097ae84c138c1db301")
  @@index([status], map: "IDX_ac0f09364e3701d9ed35435288")
  @@index([invoice_number], map: "IDX_d8f8d3788694e1b3f96c42c36f")
  @@index([booking_id], map: "IDX_ed9c7aa7846704bbcb648377e8")
}

model payments {
  id               String                       @id(map: "PK_197ab7af18c93fbb0c9b28b4a59") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime                     @default(now()) @db.Timestamp(6)
  updated_at       DateTime                     @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?                    @db.Timestamp(6)
  booking_id       String?                      @db.Uuid
  transaction_id   String?                      @db.Uuid
  amount           Decimal                      @db.Decimal(12, 2)
  currency         String                       @default("VND") @db.VarChar
  payment_method   payments_payment_method_enum @default(CASH)
  status           payments_status_enum         @default(PENDING)
  payment_gateway  String?                      @db.VarChar
  gateway_transaction_id String?                @db.VarChar
  metadata         Json?
  bookings         bookings?                    @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_e86edf76dc2424f123b9023a2b7")
  transactions     transactions?                @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_f3b90dd84859fa08f74b984a8e5")

  @@index([booking_id], map: "IDX_e86edf76dc2424f123b9023a2b")
}

model payout_requests {
  id                                        String                      @id(map: "PK_3a6acb302f56ad7dadda35c86b8") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                                DateTime                    @default(now()) @db.Timestamp(6)
  deleted_at                                DateTime?                   @db.Timestamp(6)
  user_id                                   String                      @db.Uuid
  team_id                                   String?                     @db.Uuid
  amount                                    Decimal                     @db.Decimal(15, 2)
  currency                                  String                      @default("VND") @db.VarChar(10)
  status                                    payout_requests_status_enum @default(PENDING)
  bank_name                                 String?                     @db.VarChar
  account_number                            String?                     @db.VarChar
  account_name                              String?                     @db.VarChar
  processed_at                              DateTime?                   @db.Timestamp(6)
  processed_by                              String?                     @db.Uuid
  rejection_reason                          String?
  teams                                     teams?                      @relation(fields: [team_id], references: [id], onUpdate: NoAction, map: "FK_18579b56a70f869043619ef09d6")
  users_payout_requests_processed_byTousers users?                      @relation("payout_requests_processed_byTousers", fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_28618fd3491a70c26272d6f5724")
  users_payout_requests_user_idTousers      users                       @relation("payout_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_e4bcc5d168043756413c5145a33")

  @@index([team_id], map: "IDX_18579b56a70f869043619ef09d")
  @@index([status], map: "IDX_b37667129241edaa0b214cf439")
  @@index([user_id], map: "IDX_e4bcc5d168043756413c5145a3")
}

model point_transactions {
  id           String                       @id(map: "PK_ceb5185b63f070e23d65509b0a7") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime                     @default(now()) @db.Timestamp(6)
  updated_at   DateTime                     @default(now()) @db.Timestamp(6)
  user_id      String                       @db.Uuid
  points       Int
  type         point_transactions_type_enum
  reason       String?                      @db.VarChar
  metadata     Json?
  users        users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_56702c8b9e89190347707b75552")

  @@index([user_id], map: "IDX_56702c8b9e89190347707b7555")
}

model transaction_disputes {
  id                                            String                           @id(map: "PK_9a2ccc0ba5502b911dd18290164") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                                    DateTime                         @default(now()) @db.Timestamp(6)
  updated_at                                    DateTime                         @default(now()) @db.Timestamp(6)
  deleted_at                                    DateTime?                        @db.Timestamp(6)
  transaction_id                                String                           @db.Uuid
  reporter_id                                   String                           @db.Uuid
  reason                                        String
  status                                        transaction_disputes_status_enum @default(PENDING)
  resolved_at                                   DateTime?                        @db.Timestamp(6)
  resolved_by                                   String?                          @db.Uuid
  resolution_note                               String?
  transactions                                  transactions                     @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_714ce760d0cfcd691111a1b08fb")
  users_transaction_disputes_resolved_byTousers users?                           @relation("transaction_disputes_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_c57fdb5507156a24f0c519cb2bb")
  users_transaction_disputes_reporter_idTousers users                            @relation("transaction_disputes_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d0438f78e17e521b0425a3332d4")

  @@index([transaction_id], map: "IDX_714ce760d0cfcd691111a1b08f")
  @@index([status], map: "IDX_7f355c6f84086916867a68c4e1")
  @@index([reporter_id], map: "IDX_d0438f78e17e521b0425a3332d")
}

model transactions {
  id                   String                   @id(map: "PK_a219afd8dd77ed80f5a862f1db9") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime                 @default(now()) @db.Timestamp(6)
  updated_at           DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?                @db.Timestamp(6)
  wallet_id            String                   @db.Uuid
  user_id              String?                  @db.Uuid
  booking_id           String?                  @db.Uuid
  amount               Decimal                  @db.Decimal(15, 2)
  currency             String                   @default("VND") @db.VarChar(10)
  type                 transactions_type_enum
  status               transactions_status_enum @default(PENDING)
  description          String?
  reference_id         String?                  @db.VarChar
  metadata             Json?
  invoices             invoices[]
  payments             payments[]
  transaction_disputes transaction_disputes[]
  wallets              wallets                  @relation(fields: [wallet_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_0b171330be0cb621f8d73b87a91")
  bookings             bookings?                @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_2d5fa024a84dceb158b2b95f340")
  users                users?                   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_e9acc6efa76de013e8c1553ed21")

  @@index([wallet_id], map: "IDX_0b171330be0cb621f8d73b87a9")
  @@index([type], map: "IDX_2d5fa024a84dceb158b2b95f34")
  @@index([status], map: "IDX_da87c55b3bbbe96c6ed88ea7ee")
  @@index([user_id], map: "IDX_e9acc6efa76de013e8c1553ed2")
}

model wallets {
  id           String                 @id(map: "PK_f86a9f7336ed02c8b88f347102e") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime               @default(now()) @db.Timestamp(6)
  updated_at   DateTime               @default(now()) @db.Timestamp(6)
  deleted_at   DateTime?              @db.Timestamp(6)
  owner_id     String                 @unique(map: "UQ_da87c55b3bbbe96c6ed88ea7ee2") @db.Uuid
  owner_type   wallets_owner_type_enum @default(USER)
  balance      Decimal                @default(0) @db.Decimal(15, 2)
  currency     String                 @default("VND") @db.VarChar(10)
  is_locked    Boolean                @default(false)
  transactions transactions[]
}

// ============================================================
// Payment Enums
// ============================================================

enum invoice_items_type_enum {
  BOOKING
  PRODUCT
  SERVICE
  ADDON
  MEMBERSHIP
  VOUCHER
  OTHER
}

enum invoices_status_enum {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum payments_payment_method_enum {
  CASH
  VNPAY
  MOMO
  ZALOPAY
  BANK_TRANSFER
}

enum payments_status_enum {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum payout_requests_status_enum {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum point_transactions_type_enum {
  EARN
  REDEEM
  EXPIRE
  REFUND
}

enum transaction_disputes_status_enum {
  PENDING
  OPEN
  RESOLVED
  CLOSED
}

enum transactions_status_enum {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum transactions_type_enum {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  TRANSFER
  FEE
}

enum wallets_owner_type_enum {
  USER
  TEAM
}
