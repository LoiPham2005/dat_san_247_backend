}

enum promotions_status_enum {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum payout_requests_status_enum {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum transaction_disputes_status_enum {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum point_transactions_type_enum {
  EARN
  REDEEM
  EXPIRE
  REFUND
}

enum user_vouchers_status_enum {
  UNUSED
  USED
  EXPIRED
}
