  deleted_at                                DateTime?                   @db.Timestamp(6)
  user_id                                   String                      @db.Uuid
  team_id                                   String?                     @db.Uuid
  amount                                    Decimal                     @db.Decimal(15, 2)
  currency                                  String                      @default("VND") @db.VarChar
  status                                    payout_requests_status_enum @default(PENDING)
  bankDetails                               Json
  admin_note                                String?
  rejection_reason                          String?
  proof_image_url                           String?
  processed_at                              DateTime?                   @db.Timestamp(6)
  processed_by                              String?                     @db.Uuid
  teams                                     teams?                      @relation(fields: [team_id], references: [id], onUpdate: NoAction, map: "FK_a23c65019f79f674d1b2ab7626h")
  users_payout_requests_processed_byTousers users?                      @relation("payout_requests_processed_byTousers", fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_56702c8b9e89190347707b75553")
  users_payout_requests_user_idTousers      users                       @relation("payout_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3ffb1c0c8416b9fc6f907b7430")

  @@index([team_id], map: "IDX_18579b56a70f869043619ef09d")
  @@index([status], map: "IDX_b37667129241edaa0b214cf439")
  @@index([user_id], map: "IDX_e4bcc5d168043756413c5145a3")
}

model subscription_plans {
  id                 String               @id(map: "PK_9ab8fe6918451ab3d0a4fb6bb0c") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?            @db.Timestamp(6)
  name               String               @unique(map: "UQ_ae18a0f6e0143f06474aa8cef1f") @db.VarChar
  description        String?
  monthlyPrice       Decimal              @db.Decimal(15, 2)
  yearlyPrice        Decimal              @db.Decimal(15, 2)
  currency           String               @default("VND") @db.VarChar
  features           Json
  is_active          Boolean              @default(true)
  user_subscriptions user_subscriptions[]
}

model transactions {
  id                   String                   @id(map: "PK_a219afd8dd77ed80f5a862f1db9") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime                 @default(now()) @db.Timestamp(6)
  updated_at           DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?                @db.Timestamp(6)
  user_id              String                   @db.Uuid
  wallet_id            String?                  @db.Uuid
  payment_provider     String?                  @db.VarChar
  type                 transactions_type_enum
  amount               Decimal                  @db.Decimal(15, 2)
  balanceAfter         Decimal                  @db.Decimal(15, 2)
  status               transactions_status_enum @default(PENDING)
  reference_id         String?                  @db.Uuid
  description          String?
  metadata             Json?
  invoices             invoices?
  transaction_disputes transaction_disputes[]
  bookings             bookings?                @relation(fields: [reference_id], references: [id], onUpdate: NoAction, map: "FK_365b158cbdb7b7bc18bca4004af")
  users                users                    @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_e9acc6efa76de013e8c1553ed2b")

  @@index([wallet_id], map: "IDX_0b171330be0cb621f8d73b87a9")
  @@index([type], map: "IDX_2d5fa024a84dceb158b2b95f34")
  @@index([status], map: "IDX_da87c55b3bbbe96c6ed88ea7ee")
  @@index([user_id], map: "IDX_e9acc6efa76de013e8c1553ed2")
}

model transaction_disputes {
  id                                            String                           @id(map: "PK_9a2ccc0ba5502b911dd18290164") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                                    DateTime                         @default(now()) @db.Timestamp(6)
  updated_at                                    DateTime                         @default(now()) @db.Timestamp(6)
  deleted_at                                    DateTime?                        @db.Timestamp(6)
  transaction_id                                String                           @db.Uuid
  reporter_id                                   String                           @db.Uuid
  reason                                        String
  evidence_urls                                 Json?
  status                                        transaction_disputes_status_enum @default(OPEN)
  resolution_note                               String?
  resolved_at                                   DateTime?                        @db.Timestamp(6)
  resolved_by                                   String?                          @db.Uuid
  transactions                                  transactions                     @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_714ce760d0cfcd691111a1b08fb")
  users_transaction_disputes_resolved_byTousers users?                           @relation("transaction_disputes_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_c57fdb5507156a24f0c519cb2bb")
  users_transaction_disputes_reporter_idTousers users                            @relation("transaction_disputes_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d0438f78e17e521b0425a3332d3")

  @@index([transaction_id], map: "IDX_714ce760d0cfcd691111a1b08f")
  @@index([status], map: "IDX_7f355c6f84086916867a68c4e1")
  @@index([reporter_id], map: "IDX_d0438f78e17e521b0425a3332d")
}

model user_subscriptions {
  id                 String                         @id(map: "PK_9e928b0954e51705ab44988812c") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime                       @default(now()) @db.Timestamp(6)
  updated_at         DateTime                       @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?                      @db.Timestamp(6)
  user_id            String                         @db.Uuid
  plan_id            String                         @db.Uuid
  start_date         DateTime                       @db.Timestamp(6)
  end_date           DateTime                       @db.Timestamp(6)
  status             user_subscriptions_status_enum @default(ACTIVE)
  auto_renew         Boolean                        @default(true)
  payment_method_id  String?                        @db.VarChar
  users              users                          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_0641da02314913e28f6131310eb")
  subscription_plans subscription_plans             @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_fe0520c7b2c1c5792446086491f")

  @@index([user_id], map: "IDX_0641da02314913e28f6131310e")
  @@index([status], map: "IDX_5970e6723936d28477041ebf85")
  @@index([end_date], map: "IDX_f03121e46d2dbaf2d2a8462a77")
  @@index([plan_id], map: "IDX_fe0520c7b2c1c5792446086491")
}

model wallets {
  id            String                  @id(map: "PK_8402e5df5a30a229380e83e4f7e") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime                @default(now()) @db.Timestamp(6)
  updated_at    DateTime                @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?               @db.Timestamp(6)
  owner_type    wallets_owner_type_enum @default(USER)
  owner_id      String                  @db.Uuid
  balance       Decimal                 @default(0) @db.Decimal(15, 2)
  lockedBalance Decimal                 @default(0) @db.Decimal(15, 2)
  currency      String                  @default("VND") @db.VarChar
  is_active     Boolean                 @default(true)
  payout_info   Json?
  version       Int

  @@unique([owner_type, owner_id], map: "UQ_f8ed538abffc6ba999c412ec1e9")
  @@index([owner_id], map: "IDX_1ba9a6e15c4a588af6233304ab")
}

enum invoices_status_enum {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum invoice_items_type_enum {
  BOOKING
  PRODUCT
  SERVICE
  ADDON
}

enum payments_payment_method_enum {
  CASH
  VNPAY
  MOMO
  ZALOPAY
  BANK_TRANSFER
}

enum payments_status_enum {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum payout_requests_status_enum {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum transactions_status_enum {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum transactions_type_enum {
  RECHARGE
  PAYMENT
  REFUND
  PAYOUT
  COMMISSION
}

enum transaction_disputes_status_enum {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum user_subscriptions_status_enum {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum wallets_owner_type_enum {
  USER
  TEAM
}
