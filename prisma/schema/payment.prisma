enum payments_payment_method_enum {
  CASH
  VNPAY
  MOMO
  ZALOPAY
  BANK_TRANSFER
}

enum payments_status_enum {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum invoices_status_enum {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum invoice_items_type_enum {
  BOOKING
  PRODUCT
  SERVICE
  ADDON
}

enum transactions_status_enum {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum transactions_type_enum {
  RECHARGE
  PAYMENT
  REFUND
  PAYOUT
  COMMISSION
}

enum wallets_owner_type_enum {
  USER
  TEAM
}

enum promotions_discount_type_enum {
  PERCENTAGE
