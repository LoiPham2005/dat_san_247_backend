model invoices {
  id             String               @id(map: "PK_668cef7c22a427fd822cc1be3ce") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at     DateTime             @default(now()) @db.Timestamp(6)
  updated_at     DateTime             @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?            @db.Timestamp(6)
  invoice_number String               @unique(map: "UQ_d8f8d3788694e1b3f96c42c36fb") @db.VarChar
  booking_id     String?              @unique(map: "REL_ed9c7aa7846704bbcb648377e8") @db.Uuid
  transaction_id String               @unique(map: "REL_6abcea98097ae84c138c1db301") @db.Uuid
  customer_id    String               @db.Uuid
  amount         Decimal              @db.Decimal(15, 2)
  taxAmount      Decimal              @default(0) @db.Decimal(15, 2)
  status         invoices_status_enum @default(ISSUED)
  issued_at      DateTime             @default(now()) @db.Timestamp(6)
  pdf_url        String?
  invoice_items  invoice_items[]
  users          users                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_65e3145f317bd655481d3f96c74")
  transactions   transactions         @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_6abcea98097ae84c138c1db301b")
  bookings       bookings?            @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ed9c7aa7846704bbcb648377e8f")

  @@index([customer_id], map: "IDX_65e3145f317bd655481d3f96c7")
  @@index([transaction_id], map: "IDX_6abcea98097ae84c138c1db301")
  @@index([status], map: "IDX_ac0f09364e3701d9ed35435288")
  @@index([invoice_number], map: "IDX_d8f8d3788694e1b3f96c42c36f")
  @@index([booking_id], map: "IDX_ed9c7aa7846704bbcb648377e8")
}

model invoice_items {
  id           String                  @id(map: "PK_invoice_items") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime                @default(now()) @db.Timestamp(6)
  updated_at   DateTime                @default(now()) @db.Timestamp(6)
  deleted_at   DateTime?               @db.Timestamp(6)
  invoice_id   String                  @db.Uuid
  item_type    invoice_items_type_enum
  reference_id String                  @db.Uuid
  name         String                  @db.VarChar
  quantity     Int                     @default(1)
  unit_price   Decimal                 @db.Decimal(15, 2)
  subtotal     Decimal                 @db.Decimal(15, 2)
  tax_amount   Decimal                 @default(0) @db.Decimal(15, 2)
  total_amount Decimal                 @db.Decimal(15, 2)
  invoices     invoices                @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_invoice_items_invoice")

  @@index([invoice_id])
  @@index([reference_id])
}

model payments {
  id               String                       @id(map: "PK_197ab7af18c93fbb0c9b28b4a59") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at       DateTime                     @default(now()) @db.Timestamp(6)
  updated_at       DateTime                     @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?                    @db.Timestamp(6)
  booking_id       String                       @db.Uuid
  transaction_id   String?                      @unique(map: "UQ_3c324ca49dabde7ffc0ef64675d") @db.VarChar
  amount           Decimal                      @db.Decimal(10, 2)
  payment_method   payments_payment_method_enum
  status           payments_status_enum         @default(PENDING)
  paid_at          DateTime?                    @db.Timestamp(6)
  gateway_response Json?
  bookings         bookings                     @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a2cecd1a3531c0b041e29ba46e5")

  @@index([status], map: "IDX_32b41cdb985a296213e9a928b5")
  @@index([transaction_id], map: "IDX_3c324ca49dabde7ffc0ef64675")
  @@index([booking_id], map: "IDX_e86edf76dc2424f123b9023a2b")
}

model payout_requests {
  id                                        String                      @id(map: "PK_3a6acb302f56ad7dadda35c86b8") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                                DateTime                    @default(now()) @db.Timestamp(6)
