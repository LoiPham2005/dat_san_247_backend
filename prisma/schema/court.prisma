// ============================================================
// Court Module
// ============================================================

model courts {
  id                   String              @id(map: "PK_5bfde2c29571008630327f9175d") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime            @default(now()) @db.Timestamp(6)
  updated_at           DateTime            @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?           @db.Timestamp(6)
  venue_id             String              @db.Uuid
  name                 String              @db.VarChar
  description          String?
  sport_types          Json?
  court_type           String?             @db.VarChar
  surface_type         String?             @db.VarChar
  is_indoor            Boolean             @default(false)
  is_outdoor           Boolean             @default(false)
  is_active            Boolean             @default(true)
  base_price           Decimal?            @db.Decimal(10, 2)
  price_per_hour       Decimal             @default(0) @db.Decimal(10, 2)
  parent_court_id      String?             @db.Uuid
  thumbnail_url        String?
  amenities            Json?
  bookings             bookings[]
  court_images         court_images[]
  court_maintenance    court_maintenance[]
  venues               venues              @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_1d3e891da949aff1d5b7c060609")
  match_findings       match_findings[]
  pricing_rules        pricing_rules[]
  promotion_courts     promotion_courts[]
  reviews              reviews[]
  time_slots           time_slots[]
  user_behaviors       user_behaviors[]

  @@index([venue_id], map: "IDX_1d3e891da949aff1d5b7c06060")

}

model court_images {
  id            String    @id(map: "PK_cc3c5019f79f674d1b2ab7626d0") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)
  court_id      String    @db.Uuid
  file_id       String    @db.Uuid
  display_order Int       @default(0)
  courts        courts    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a23c65019f79f674d1b2ab7626c")
  files         files     @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_fbcd17ae4cc11d0bd874a3b10da")
}

model court_maintenance {
  id         String    @id(map: "PK_69a15349ca5e00f8e36ec17a8f3") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  court_id   String    @db.Uuid
  start_date DateTime  @db.Timestamp(6)
  end_date   DateTime  @db.Timestamp(6)
  reason     String?
  courts     courts    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a2cecd1a3531c0b041e29ba46e3")
}

model pricing_rules {
  id            String                       @id(map: "PK_091cad75e1b23902fdac1146fee") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime                     @default(now()) @db.Timestamp(6)
  updated_at    DateTime                     @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?                    @db.Timestamp(6)
  court_id      String                       @db.Uuid
  name          String?                      @db.VarChar
  day_of_week   pricing_rules_dayofweek_enum
  start_time    DateTime                     @db.Time(6)
  end_time      DateTime                     @db.Time(6)
  price         Decimal                      @default(0) @db.Decimal(10, 2)
  price_modifier Decimal?                    @db.Decimal(10, 2)
  is_percentage Boolean                      @default(false)
  priority      Int                          @default(1)
  is_active     Boolean                      @default(true)
  start_date    DateTime?                    @db.Date
  end_date      DateTime?                    @db.Date
  courts        courts                       @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a23c65019f79f674d1b2ab7626d")
}

// ============================================================
// Court Enums
// ============================================================

enum pricing_rules_dayofweek_enum {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
