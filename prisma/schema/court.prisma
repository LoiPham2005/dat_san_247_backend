model courts {
  id                 String               @id(map: "PK_948a5d356c3083f3237ecbf9897") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?            @db.Timestamp(6)
  venue_id           String               @db.Uuid
  name               String               @db.VarChar
  sport_types        Json
  description        String?
  price_per_hour     Decimal              @db.Decimal(10, 2)
  size               String?              @db.VarChar
  is_indoor          Boolean              @default(false)
  is_outdoor         Boolean              @default(false)
  surface_type       String?              @db.VarChar
  width              Decimal?             @db.Decimal(5, 2)
  length             Decimal?             @db.Decimal(5, 2)
  height             Decimal?             @db.Decimal(5, 2)
  parent_court_id    String?              @db.Uuid
  is_active          Boolean              @default(true)
  thumbnail_url      String?
  amenities          Json?
  ai_recommendations ai_recommendations[]
  booking_waitlist   booking_waitlist[]
  bookings           bookings[]
  court_images       court_images[]
  court_maintenance  court_maintenance[]
  venues             venues               @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_1d3e891da949aff1d5b7c060609")
  courts             courts?              @relation("courtsTocourts", fields: [parent_court_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_b4df04139f6a24b87c27c1eeb09")
  other_courts       courts[]             @relation("courtsTocourts")
  match_findings     match_findings[]
  pricing_rules      pricing_rules[]
  promotion_courts   promotion_courts[]
  recurring_bookings recurring_bookings[]
  reviews            reviews[]
  time_slots         time_slots[]
  user_behaviors     user_behaviors[]

  @@index([is_active], map: "IDX_57d99fcb99d59b5666ef033b33")
  @@index([sport_types], map: "IDX_80679ee45c2e0d285b648ed768")
  @@index([venue_id], map: "IDX_9da2e37c269dfe8cbbfd8d8758")
}

model court_images {
  id            String    @id(map: "PK_b9d513f2bdfe3920fb30db48ba5") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)
  court_id      String    @db.Uuid
  file_id       String    @db.Uuid
  display_order Int       @default(0)
  is_cover      Boolean   @default(false)
  caption       String?   @db.VarChar
  courts        courts    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a23c65019f79f674d1b2ab7626c")
  files         files     @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_fbcd17ae4cc11d0bd874a3b10da")

  @@index([file_id], map: "IDX_84686c69dc61195925075b4988")
  @@index([court_id], map: "IDX_e676d7863d3e39bb0f704e3334")
}

model court_maintenance {
  id           String    @id(map: "PK_bb48925dc4150b1ab1a319523a8") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)
  deleted_at   DateTime? @db.Timestamp(6)
  court_id     String    @db.Uuid
  start_date   DateTime  @db.Timestamp(6)
  end_date     DateTime  @db.Timestamp(6)
  reason       String
  is_emergency Boolean   @default(false)
  courts       courts    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a2cecd1a3531c0b041e29ba46e3")

  @@index([court_id], map: "IDX_215452b7cdd113d35bb1583d30")
}

model pricing_rules {
  id          String                        @id(map: "PK_fda27bb8db4630894decda61ff6") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at  DateTime                      @default(now()) @db.Timestamp(6)
  updated_at  DateTime                      @default(now()) @db.Timestamp(6)
  deleted_at  DateTime?                     @db.Timestamp(6)
  court_id    String                        @db.Uuid
  day_of_week pricing_rules_dayofweek_enum? @map("day_of_week")
  start_time  DateTime                      @db.Time(6)
  end_time    DateTime                      @db.Time(6)
  price       Decimal                       @db.Decimal(10, 2)
  start_date  DateTime?                     @db.Date
  end_date    DateTime?                     @db.Date
  priority    Int                           @default(1)
  is_active   Boolean                       @default(true)
  courts      courts                        @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a23c65019f79f674d1b2ab7626d")
}

enum pricing_rules_dayofweek_enum {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
