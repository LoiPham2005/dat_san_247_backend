// ============================================================
// Chat Module
// ============================================================

model chat_conversations {
  id                   String                       @id(map: "PK_ff117d9f57807c4f2e3034a39f3") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime                     @default(now()) @db.Timestamp(6)
  updated_at           DateTime                     @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?                    @db.Timestamp(6)
  type                 chat_conversations_type_enum
  name                 String?                      @db.VarChar(255)
  avatar_url           String?
  description          String?
  venue_id             String?                      @db.Uuid
  is_team              Boolean                      @default(false)
  team_id              String?                      @db.Uuid
  match_finding_id     String?                      @db.Uuid
  max_members          Int                          @default(50)
  is_muted             Boolean                      @default(false)
  is_archived          Boolean                      @default(false)
  allow_members_invite Boolean                      @default(true)
  last_message_id      String?                      @db.Uuid
  last_message_at      DateTime?                    @db.Timestamp(6)
  total_messages       Int                          @default(0)
  total_members        Int                          @default(0)
  created_by           String?                      @db.Uuid
  users                users?                       @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "FK_538bbdd8b128eec3a65d10ce1af")
  venues               venues?                      @relation(fields: [venue_id], references: [id], onUpdate: NoAction, map: "FK_8af5a7bb72e64dcdec39b1e7603")
  teams                teams?                       @relation(fields: [team_id], references: [id], onUpdate: NoAction, map: "FK_cd3a75c7450f650885d414d2682")
  match_findings       match_findings?              @relation(fields: [match_finding_id], references: [id], onUpdate: NoAction, map: "FK_f77fa43c8b826180a924d203e1e")
  chat_members         chat_members[]
  chat_messages        chat_messages[]
  support_tickets      support_tickets?

  @@index([type], map: "IDX_1531d800679a2491503c87b47b")
}

model chat_members {
  id                   String                 @id(map: "PK_aea646f59c92c47af5804ce73a7") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?              @db.Timestamp(6)
  conversation_id      String                 @db.Uuid
  user_id              String                 @db.Uuid
  role                 chat_members_role_enum @default(MEMBER)
  nickname             String?                @db.VarChar(100)
  is_muted             Boolean                @default(false)
  is_pinned            Boolean                @default(false)
  last_read_message_id String?                @db.Uuid
  last_read_at         DateTime?              @db.Timestamp(6)
  unread_count         Int                    @default(0)
  notification_enabled Boolean                @default(true)
  joined_at            DateTime               @default(now()) @db.Timestamp(6)
  left_at              DateTime?              @db.Timestamp(6)
  chat_conversations   chat_conversations     @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_785059c3d3e5425fb8862ccc14e")
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_9dc61e92eed1dc151c2b2ef01a0")

  @@unique([conversation_id, user_id], map: "UQ_a3ffb1c0c8416b9fc6f907b7432")
}

model chat_messages {
  id                   String                   @id(map: "PK_cb0f885278d12384eb7a81818c5") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime                 @default(now()) @db.Timestamp(6)
  updated_at           DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?                @db.Timestamp(6)
  conversation_id      String                   @db.Uuid
  sender_id            String                   @db.Uuid
  type                 chat_messages_type_enum  @default(TEXT)
  content              String?
  metadata             Json?
  parent_id            String?                  @db.Uuid
  reply_to_message_id  String?                  @db.Uuid
  booking_id           String?                  @db.Uuid
  venue_id             String?                  @db.Uuid
  media_urls           Json?
  location             Json?
  is_edited            Boolean                  @default(false)
  edited_at            DateTime?                @db.Timestamp(6)
  is_deleted           Boolean                  @default(false)
  deleted_for_everyone Boolean                  @default(false)
  chat_conversations   chat_conversations       @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6879854746f3684a0d9276dl8a2")
  users                users                    @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_a3ffb1c0c8416b9fc6f907b7434")
  chat_message_reactions chat_message_reactions[]
  chat_message_receipts  chat_message_receipts[]
  chat_messages          chat_messages?           @relation("chat_messagesTochat_messages", fields: [parent_id], references: [id], onUpdate: NoAction, map: "FK_a2cecd1a3531c0b041e29ba46e7")
  other_chat_messages    chat_messages[]          @relation("chat_messagesTochat_messages")
}

model chat_message_reactions {
  id            String        @id(map: "PK_cb0f885278d12384eb7a81818c6") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  message_id    String        @db.Uuid
  user_id       String        @db.Uuid
  emoji         String        @db.VarChar(50)
  chat_messages chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6879854746f3684a0d9276dl8a3")
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3ffb1c0c8416b9fc6f907b7436")

  @@unique([message_id, user_id, emoji], map: "UQ_a3ffb1c0c8416b9fc6f907b7434")
}

model chat_message_receipts {
  id            String                          @id(map: "PK_cb0f885278d12384eb7a81818c7") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  message_id    String                          @db.Uuid
  user_id       String                          @db.Uuid
  status        chat_message_receipts_status_enum @default(SENT)
  read_at       DateTime?                       @db.Timestamp(6)
  chat_messages chat_messages                   @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6879854746f3684a0d9276dl8a4")
  users         users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3ffb1c0c8416b9fc6f907b7437")

  @@unique([message_id, user_id], map: "UQ_a3ffb1c0c8416b9fc6f907b7435")
}

model chat_settings {
  id                 String    @id(map: "PK_cb0f885278d12384eb7a81818c8") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)
  user_id            String    @unique @db.Uuid
  allow_direct_msgs  Boolean   @default(true)
  show_online_status Boolean   @default(true)
  show_read_receipts Boolean   @default(true)
  notification_sound String    @default("default") @db.VarChar
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3ffb1c0c8416b9fc6f907b7438")
}

model chat_templates {
  id            String                       @id(map: "PK_cb0f885278d12384eb7a81818c9") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at    DateTime                     @default(now()) @db.Timestamp(6)
  updated_at    DateTime                     @default(now()) @db.Timestamp(6)
  user_id       String                       @db.Uuid
  title         String                       @db.VarChar
  content       String
  category      chat_templates_category_enum @default(OTHER)
  display_order Int                          @default(0)
  users         users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_a3ffb1c0c8416b9fc6f907b7439")
}

// ============================================================
// Chat Enums
// ============================================================

enum chat_conversations_type_enum {
  DIRECT
  GROUP
  TEAM
  VENUE_SUPPORT
  CUSTOMER_SUPPORT
}

enum chat_members_role_enum {
  OWNER
  ADMIN
  CAPTAIN
  VICE_CAPTAIN
  MEMBER
}

enum chat_message_receipts_status_enum {
  SENT
  DELIVERED
  READ
  FAILED
}

enum chat_messages_type_enum {
  TEXT
  IMAGE
  VIDEO
  FILE
  AUDIO
  LOCATION
  BOOKING
  VENUE
  SYSTEM
}

enum chat_templates_category_enum {
  GREETING
  PRICING
  AVAILABILITY
  LOCATION
  RULES
  OTHER
}
