model match_findings {
  id                 String                             @id(map: "PK_c1d8b6fdbdc3b535c7371e36ce8") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at         DateTime                           @default(now()) @db.Timestamp(6)
  updated_at         DateTime                           @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?                          @db.Timestamp(6)
  organizer_id       String                             @db.Uuid
  organizer_type     match_findings_organizer_type_enum @default(USER)
  venue_id           String?                            @db.Uuid
  court_id           String?                            @db.Uuid
  booking_id         String?                            @db.Uuid
  sport_type         String                             @db.VarChar
  skill_level        String?                            @db.VarChar(50)
  match_date         DateTime                           @db.Date
  start_time         DateTime                           @db.Time(6)
  end_time           DateTime                           @db.Time(6)
  min_players        Int                                @default(2)
  max_players        Int                                @default(10)
  current_players    Int                                @default(1)
  description        String?
  challenge_type     match_findings_challenge_type_enum @default(FRIENDLY)
  split_type         String                             @default("FAIR") @db.VarChar
  amount_per_person  Decimal?                           @db.Decimal(10, 2)
  status             match_findings_status_enum         @default(OPEN)
  team_id            String?                            @db.Uuid
  chat_conversations chat_conversations[]
  bookings           bookings?                          @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_403c65019f79f674d1b2ab7626f")
  courts             courts?                            @relation(fields: [court_id], references: [id], onUpdate: NoAction, map: "FK_683c918634ad172b538db1a3541")
  users              users                              @relation(fields: [organizer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_89462187c0bae5f5cab7574a849")
  teams              teams?                             @relation(fields: [team_id], references: [id], onUpdate: NoAction, map: "FK_a23c65019f79f674d1b2ab7626j")
  venues             venues?                            @relation(fields: [venue_id], references: [id], onUpdate: NoAction, map: "FK_cb0f885278d12384eb7a81818c0")
  match_participants match_participants[]
  match_results      match_results[]
}

