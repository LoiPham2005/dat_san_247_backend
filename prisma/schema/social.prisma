  max_teams               Int                       @default(16)
  entry_fee               Decimal                   @default(0) @db.Decimal(15, 2)
  prize_structure         Json?
  registration_deadline   DateTime?                 @db.Timestamp(6)
  rules                   String?
  status                  tournaments_status_enum   @default(PLANNING)
  created_by              String                    @db.Uuid
  tournament_brackets     tournament_brackets[]
  tournament_participants tournament_participants[]
  users                   users                     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_7226123ffd07a241f4a25beeda6")
  venues                  venues                    @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_998fba19916f4f6e4bf33fadf7a")

  @@index([sport_type], map: "IDX_29999d70c18cf6152ec00fe495")
  @@index([venue_id], map: "IDX_998fba19916f4f6e4bf33fadf7")
}

